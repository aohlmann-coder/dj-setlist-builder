  { cat:"Country",    keys:["country","americana","bluegrass","folk","outlaw country"] },
  { cat:"Reggae",     keys:["reggae","roots reggae","reggaeton","latin","ska","dancehall","afrobeats","afropop","soca"] },
];
function normalizeGenre(rawGenre) {
  if (!rawGenre || !rawGenre.trim()) return "";
  const tags = rawGenre.toLowerCase().replace(/;/g,",").split(",").map(t=>t.trim()).filter(Boolean);
  for (const tag of tags) {
    for (const { cat, keys } of GENRE_KEYWORD_MAP) {
      if (keys.some(k => tag.includes(k))) return cat;
    }
  }
  return "";
}

// ─── EXPORTIFY FILE PARSER ────────────────────────────────────────────────────
async function parseExportifyFile(file, onProgress) {
  const ext = file.name.split(".").pop().toLowerCase();
  let rows = []; // array of {header: value} objects

  if (ext === "csv") {
    const text = await file.text();
    const lines = text.split(/\r?\n/);
    const headers = lines[0].split(",").map(h => h.replace(/^"|"$/g, "").trim());
    for (let i = 1; i < lines.length; i++) {
      if (!lines[i].trim()) continue;
      // CSV split that handles quoted fields with commas
      const vals = [];
      let cur = "", inQ = false;
      for (const ch of lines[i]) {
        if (ch === '"') { inQ = !inQ; }
        else if (ch === "," && !inQ) { vals.push(cur); cur = ""; }
        else cur += ch;
      }
      vals.push(cur);
      const obj = {};
      headers.forEach((h, idx) => { obj[h] = (vals[idx] || "").replace(/^"|"$/g, "").trim(); });
      rows.push(obj);
    }
  } else if (ext === "xlsx") {
    // Use SheetJS loaded from CDN
    if (!window.XLSX) throw new Error("SheetJS not loaded");
    const buf = await file.arrayBuffer();
    const wb = window.XLSX.read(buf, { type: "array", cellDates: true });
    const ws = wb.Sheets[wb.SheetNames[0]];
    rows = window.XLSX.utils.sheet_to_json(ws, { raw: false, defval: "" });
  } else {
    throw new Error("Unsupported file type. Use .csv or .xlsx from Exportify.");
  }

  const cache = loadLibCache();
  const songs = [];
  let saved = 0;
  const needsAiGenre = [];

  for (const r of rows) {
    const name  = r["Track Name"] || "";
    const artist = (r["Artist Name(s)"] || "").split(";")[0].trim();
    const allArtists = (r["Artist Name(s)"] || "").replace(/;/g, ", ");
    if (!name || !artist) continue;

    const keyNum  = parseInt(r["Key"])  ?? 0;
    const modeNum = parseInt(r["Mode"]) ?? 1;
    const bpm     = Math.round(parseFloat(r["Tempo"]) || 0);
    const energy  = Math.round((parseFloat(r["Energy"]) || 0.5) * 100);
    const dance   = Math.round((parseFloat(r["Danceability"]) || 0.6) * 100);
    const valence = Math.round((parseFloat(r["Valence"]) || 0.6) * 100);
    const inst    = Math.round((parseFloat(r["Instrumentalness"]) || 0) * 100);
    const sp      = Math.round((parseFloat(r["Speechiness"]) || 0) * 100);
    const dur     = parseInt(r["Duration (ms)"]) || 0;
    const uri     = r["Track URI"] || "";
    const id      = uri.replace("spotify:track:", "") || (name + artist).replace(/[^a-z0-9]/gi, "");
    const relYear = parseInt((r["Release Date"] || "").toString().substring(0, 4)) || 0;
    const era     = relYear >= 1950 ? (Math.floor(relYear / 10) * 10) + "s" : "";

    const rawGenre = r["Genres"] || "";
    const genre = normalizeGenre(rawGenre);
    if (!genre) needsAiGenre.push({ idx: songs.length, name, artist, rawGenre });

    songs.push({ id, n: name, a: allArtists, du: dur, uri, img: "", source: "spotify",
      b: bpm, key: keyNum, mode: modeNum, e: energy, d: dance, v: valence, inst, sp,
      g: genre || "Other", era });
  }

  if (onProgress) onProgress("Parsed " + songs.length + " tracks — filling " + needsAiGenre.length + " missing genres with AI...");

  const apiKey = getAnthropicKey();
  if (needsAiGenre.length > 0 && apiKey) {
    const BATCH = 40;
    for (let i = 0; i < needsAiGenre.length; i += BATCH) {
      const batch = needsAiGenre.slice(i, i + BATCH);
      const list = batch.map((s, j) =>
        (j+1) + ". \"" + s.name + "\" by " + s.artist + (s.rawGenre ? " [tags: " + s.rawGenre + "]" : "")
      ).join("\n");
      const cats = "Hip Hop, Rap, R&B, Funk/Soul, Disco, Pop, Rock, Electronic, Dance, Country, Reggae, Other";
      const prompt = "Classify each song into EXACTLY ONE of these genres:\n" + cats + "\n\nSongs:\n" + list + "\n\nReturn ONLY a JSON array of strings, one per song. No explanation.";
      try {
        const resp = await fetch("https://api.anthropic.com/v1/messages", {
          method: "POST",
          headers: { "Content-Type":"application/json","x-api-key":apiKey,"anthropic-version":"2023-06-01","anthropic-dangerous-direct-browser-access":"true" },
          body: JSON.stringify({ model:"claude-haiku-4-5-20251001", max_tokens:600, messages:[{role:"user",content:prompt}] }),
        });
        if (resp.ok) {
          const data = await resp.json();
          const text = (data.content?.[0]?.text||"").replace(/```json|```/g,"").trim();
          const results = JSON.parse(text);
          batch.forEach((s, j) => {
            if (results[j] && GENRE_CATEGORIES.includes(results[j])) songs[s.idx].g = results[j];
          });
        }
      } catch(e) { console.warn("[DJ] AI genre batch:", e.message); }
      if (onProgress) onProgress("AI genres: " + Math.min(i+BATCH, needsAiGenre.length) + "/" + needsAiGenre.length + "...");
    }
  }

  for (const song of songs) {
    const primaryArtist = song.a.split(",")[0].trim();
    const enrichData = { b:song.b, key:song.key, mode:song.mode, e:song.e, d:song.d, v:song.v, inst:song.inst, sp:song.sp, g:song.g, era:song.era };
    const ckPrimary = libCacheKey(song.n, primaryArtist);
    const ckAll     = libCacheKey(song.n, song.a);
    cache[ckPrimary] = { ...enrichData, _exportify: true };
    if (ckAll !== ckPrimary) cache[ckAll] = { ...enrichData, _exportify: true };
    saved++;
  }

  saveLibCache(cache);
  console.log(`[DJ] Exportify: ${songs.length} tracks, ${saved} cached, ${needsAiGenre.length} AI-genre-filled`);
  return { songs, saved };
}

