                        const dN = camelotDistance(currCam, sCam);
                        return dP !== null && dP <= 1 && dN !== null && dN <= 1 && s.b > 0;
                      });
                      if (bridgeSong) bridges.push({ idx:i, from:setlist[i-1], to:setlist[i], bridge:bridgeSong, prevCam, currCam });
                    }
