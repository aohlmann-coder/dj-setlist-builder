function vibeScore(song, vibe) {
  const { e = 50, b = 100, d = 60 } = song;
  let s = 0;
  s += e >= vibe.eMin && e <= vibe.eMax ? 35 : Math.max(0, 35 - Math.abs(e - (vibe.eMin + vibe.eMax) / 2) * 0.5);
  s += b >= vibe.bMin && b <= vibe.bMax ? 30 : Math.max(0, 30 - Math.abs(b - (vibe.bMin + vibe.bMax) / 2) * 0.3);
  s += d >= vibe.dMin && d <= vibe.dMax ? 20 : Math.max(0, 20 - Math.abs(d - (vibe.dMin + vibe.dMax) / 2) * 0.3);
  return Math.round(Math.min(100, Math.max(0, s)));
}

