}

// ─── CLAUDE AI ENRICHMENT ─────────────────────────────────────────────────────
// Sends batches of 20 songs to Claude, gets back BPM, key, energy, genre, etc.
// Results are permanently cached in localStorage.

async function enrichTracksWithClaude(tracks, apiKey, onProgress) {
  const cache = loadLibCache();
  const enriched = [...tracks];
  let cacheHits = 0;

  // First pass: apply cache hits
  for (let i = 0; i < enriched.length; i++) {
    const ck = libCacheKey(enriched[i].n, enriched[i].a);
    if (cache[ck] && (cache[ck].b > 0 || cache[ck]._exportify)) {
      enriched[i] = { ...enriched[i], ...cache[ck] };
      cacheHits++;
    }
  }
  console.log("[DJ] Cache hits:", cacheHits, "/", tracks.length);

  // Second pass: fetch only tracks with no real data (not exportify-cached, not already enriched)
  const needsEnrich = enriched.filter(t => !t._exportify && (!t.b || t.b === 0));
  if (!needsEnrich.length) {
    if (onProgress) onProgress(tracks.length, tracks.length, cacheHits);
    return enriched;
  }

  if (!apiKey) {
    console.warn("[DJ] No Anthropic API key — skipping enrichment");
    if (onProgress) onProgress(tracks.length, tracks.length, cacheHits);
    return enriched;
  }

  const BATCH = 20;
  let done = cacheHits;

  for (let i = 0; i < needsEnrich.length; i += BATCH) {
    const batch = needsEnrich.slice(i, i + BATCH);
    const songList = batch.map((t, idx) =>
      `${idx + 1}. "${t.n}" by ${t.a}`
    ).join("\n");

    const prompt = `You are a music data expert. For each song below, provide accurate music data.
Return ONLY a valid JSON array — no markdown, no explanation, no backticks.
Each object must have exactly these fields:
- "i": the song number (integer)
- "bpm": tempo in beats per minute (integer, e.g. 95)
- "key": musical key as string (e.g. "Am", "C#", "Bb", "F#m")
- "energy": 0-100 integer (0=very calm, 100=extremely intense)
- "valence": 0-100 integer (0=sad/dark, 100=happy/euphoric)
- "danceability": 0-100 integer (0=not danceable, 100=extremely danceable)
- "genre": comma-separated genres, max 3 (e.g. "R&B,Soul,Funk")
- "era": decade as string (e.g. "90s", "2000s", "2010s")

Songs:
${songList}

Return only the JSON array, nothing else.`;

    try {
      console.log("[DJ] Claude enriching batch", i/BATCH+1, "of", Math.ceil(needsEnrich.length/BATCH));
      const resp = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "x-api-key": apiKey,
          "anthropic-version": "2023-06-01",
          "anthropic-dangerous-direct-browser-access": "true",
        },
        body: JSON.stringify({
          model: "claude-haiku-4-5-20251001",
          max_tokens: 2000,
          messages: [{ role: "user", content: prompt }],
        }),
      });

      if (!resp.ok) {
        const err = await resp.text();
        console.warn("[DJ] Claude API error:", resp.status, err);
        done += batch.length;
        if (onProgress) onProgress(done, tracks.length, cacheHits);
        continue;
      }

      const data = await resp.json();
      const text = data.content?.[0]?.text || "";

      // Parse JSON — strip any accidental markdown fences
      const clean = text.replace(/```json|```/g, "").trim();
      const results = JSON.parse(clean);

      // Map results back to tracks and save to cache
      for (const r of results) {
        const idx = r.i - 1;
        if (idx < 0 || idx >= batch.length) continue;
        const t = batch[idx];
        const [keyNum, modeNum] = parseKeyString(r.key || "C");
        const enrichData = {
          b:    Math.round(r.bpm)    || 0,
          key:  keyNum,
          mode: modeNum,
          e:    Math.min(100, Math.max(0, Math.round(r.energy)))       || 50,
          v:    Math.min(100, Math.max(0, Math.round(r.valence)))      || 60,
          d:    Math.min(100, Math.max(0, Math.round(r.danceability))) || 60,
          g:    r.genre  || "",
          era:  r.era    || "",
        };
        // Save to cache — never overwrite Exportify data
        const ck = libCacheKey(t.n, t.a);
        if (!cache[ck]?._exportify) cache[ck] = enrichData;
        // Apply to enriched array — never overwrite Exportify data on track object
        const globalIdx = enriched.findIndex(x => x.id === t.id);
        if (globalIdx >= 0 && !enriched[globalIdx]._exportify) {
          enriched[globalIdx] = { ...enriched[globalIdx], ...enrichData };
        }
      }

      saveLibCache(cache);
      done += batch.length;
      if (onProgress) onProgress(done, tracks.length, cacheHits);

      // Small delay between batches to be polite
      if (i + BATCH < needsEnrich.length) await new Promise(r => setTimeout(r, 300));

    } catch (err) {
      console.warn("[DJ] Claude batch error:", err);
      done += batch.length;
      if (onProgress) onProgress(done, tracks.length, cacheHits);
    }
  }

  saveLibCache(cache);
  console.log("[DJ] Enrichment complete. Cache hits:", cacheHits, "| API calls:", Math.ceil(needsEnrich.length / BATCH));
  return enriched;
}
async function createSpotifyPlaylist(name, uris, token) {
  const pl = await fetch("https://api.spotify.com/v1/me/playlists", {
    method: "POST",
    headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
    body: JSON.stringify({ name, description: "Created by DJ Setlist Builder — setlist in order", public: false }),
  }).then(r => r.json());
  // Add tracks in order, batch by batch, with position to guarantee order
  for (let i = 0; i < uris.length; i += 100) {
    const batch = uris.slice(i, i + 100);
    const resp = await fetch(`https://api.spotify.com/v1/playlists/${pl.id}/items`, {
      method: "POST",
      headers: { Authorization: "Bearer " + token, "Content-Type": "application/json" },
      body: JSON.stringify({ uris: batch, position: i }),
    });
    if (!resp.ok) console.warn("[DJ] Export batch error at position", i, ":", resp.status);
    // Small delay between batches to avoid rate limits
    if (i + 100 < uris.length) await new Promise(r => setTimeout(r, 200));
  }
  return pl;
}

