// ─── DRAGGABLE FLAT SETLIST ───────────────────────────────────────────────────
function DraggableSetlist({ setlist, setSetlist, expandedId, onToggle, onRemove, vibeObj, onPlay, playingId, elapsedFullArr, elapsedCueArr, mixsetTransitions, isMixSet, isPhaseMode }) {
  const dragItem = React.useRef(null);
  const dragOver = React.useRef(null);
  const [dragging, setDragging] = React.useState(null);
  const [dropTarget, setDropTarget] = React.useState(null);
  const [collapsedGenres, setCollapsedGenres] = React.useState({});

  const handleDragStart = (i) => { dragItem.current = i; setDragging(i); };
  const handleDragEnter = (i) => { dragOver.current = i; setDropTarget(i); };
  const handleDragEnd = () => {
    if (dragItem.current === null || dragOver.current === null) { setDragging(null); setDropTarget(null); return; }
    const from = dragItem.current, to = dragOver.current;
    if (from !== to) {
      setSetlist(prev => {
        const next = [...prev];
        const [moved] = next.splice(from, 1);
        next.splice(to, 0, moved);
        return next;
      });
    }
    dragItem.current = null; dragOver.current = null;
    setDragging(null); setDropTarget(null);
  };

  const moveToPosition = (from, to) => {
    setSetlist(prev => {
      const next = [...prev];
      const [moved] = next.splice(from, 1);
      next.splice(to, 0, moved);
      return next;
    });
  };

  const toggleGenre = (genre) => {
    setCollapsedGenres(prev => ({ ...prev, [genre]: !prev[genre] }));
  };

  // Genre color palette — cycle through these for visual separation
  const GENRE_COLORS = [
    "#f472b6","#22d3ee","#4ade80","#f97316","#a78bfa",
    "#facc15","#fb923c","#38bdf8","#34d399","#e879f9",
    "#f87171","#60a5fa","#86efac","#fbbf24","#c084fc",
  ];

  const primaryGenre = song => {
    const raw = song.g || "";
    const norm = normalizeGenre(raw);
    if (norm) return norm;
    if (GENRE_CATEGORIES.includes(raw.split(",")[0].trim())) return raw.split(",")[0].trim();
    return "Other";
  };

  // Fixed color per category — consistent across all setlists
  const GENRE_COLOR_FIXED = {
    "Hip Hop":    "#f472b6",
    "Rap":        "#e879f9",
    "R&B":        "#22d3ee",
    "Funk/Soul":  "#f97316",
    "Disco":      "#facc15",
    "Pop":        "#4ade80",
    "Rock":       "#fb923c",
    "Electronic": "#38bdf8",
    "Dance":      "#a78bfa",
    "Country":    "#86efac",
    "Reggae":     "#34d399",
    "Other":      "#888888",
  };
  const genreColorMap = React.useMemo(() => {
    const map = {};
    for (const song of setlist) {
      const g = primaryGenre(song);
      if (!map[g]) map[g] = GENRE_COLOR_FIXED[g] || "#888";
    }
    return map;
  }, [setlist]);

  const rows = [];
  let currentGenre = null;
  let currentPhaseId = null;
  let currentPhaseName = null;
  let globalIdx = 0; // track real index for transitions even when some are hidden

  setlist.forEach((song, i) => {
    const genre = (isMixSet && song._mixsetGenre) ? song._mixsetGenre : primaryGenre(song);
    const genreKey = genre.toLowerCase();
    const genreColor = genreColorMap[genreKey] || "#888";
    const isCollapsed = !!collapsedGenres[genreKey];

    // Genre header — insert when genre changes in Mix Set modes
    if (isMixSet && genre !== currentGenre) {
      currentGenre = genre;
      let genreCount = 0;
      for (let j = i; j < setlist.length; j++) {
        const g = (isMixSet && setlist[j]._mixsetGenre) ? setlist[j]._mixsetGenre.toLowerCase() : primaryGenre(setlist[j]).toLowerCase();
        if (g === genreKey) genreCount++; else break;
      }
      const genreSongs = setlist.slice(i, i + genreCount);
      const bpms = genreSongs.map(s => s.b || 0).filter(b => b > 0);
      const bpmRange = bpms.length ? `${Math.min(...bpms)}–${Math.max(...bpms)} BPM` : "";
      const keys = [...new Set(genreSongs.map(s => fmtKey(s.key, s.mode, getCamelot(s.key||0, s.mode||0))))];
      const keyStr = keys.slice(0, 4).join(", ") + (keys.length > 4 ? "…" : "");
      rows.push(
        <div key={"genre-" + genreKey + "-" + i} onClick={() => toggleGenre(genreKey)} style={{ display:"flex", alignItems:"center", gap:8, padding:"8px 12px", borderRadius:6, cursor:"pointer", background:`rgba(${parseInt(genreColor.slice(1,3),16)},${parseInt(genreColor.slice(3,5),16)},${parseInt(genreColor.slice(5,7),16)},0.08)`, borderLeft:"4px solid " + genreColor, border:"1px solid " + genreColor + "40", marginTop: i > 0 ? 14 : 0, marginBottom:4, userSelect:"none" }}>
          <span style={{ color:genreColor, fontSize:12, transform: isCollapsed ? "rotate(-90deg)" : "rotate(0)", transition:"transform .2s", display:"inline-block" }}>▾</span>
          <div style={{ flex:1 }}>
            <div style={{ fontSize:13, fontWeight:800, color:genreColor, textTransform:"capitalize", letterSpacing:.3 }}>{genre}</div>
            <div style={{ fontSize:9, color:"#555", marginTop:2 }}>{genreCount} tracks · {bpmRange}{keyStr ? " · " + keyStr : ""}</div>
          </div>
          <span style={{ fontSize:9, color: isCollapsed ? genreColor : "#555", fontWeight:600, padding:"2px 7px", borderRadius:3, background: isCollapsed ? genreColor+"22" : "transparent", border:"1px solid " + (isCollapsed ? genreColor+"44" : "transparent") }}>
            {isCollapsed ? "show" : "hide"}
          </span>
        </div>
      );
    }

    // Phase Flow mode headers
    if (isPhaseMode) {
      const pName = song._phaseName || "Other";
      if (pName !== currentPhaseName) {
        currentPhaseName = pName;
        const pDef = PHASE_DEFS.find(p => p.name === pName);
        const pColor = pDef ? pDef.color : "#888";
        const pSongs = setlist.filter(s => s._phaseName === pName);
        const pBpms = pSongs.map(s => s.b||0).filter(b=>b>0);
        const pRange = pBpms.length ? `${Math.min(...pBpms)}–${Math.max(...pBpms)} BPM` : "";
        rows.push(
          <div key={"phase-hdr-" + pName + "-" + i} onClick={() => toggleGenre("phase_"+pName)} style={{ display:"flex", alignItems:"center", gap:8, padding:"8px 12px", borderRadius:6, cursor:"pointer", background:`rgba(${parseInt(pColor.slice(1,3),16)||0},${parseInt(pColor.slice(3,5),16)||0},${parseInt(pColor.slice(5,7),16)||0},0.08)`, borderLeft:"4px solid "+pColor, border:"1px solid "+pColor+"40", marginTop: i>0?14:0, marginBottom:4, userSelect:"none" }}>
            <span style={{ color:pColor, fontSize:12, transform: collapsedGenres["phase_"+pName]?"rotate(-90deg)":"rotate(0)", transition:"transform .2s", display:"inline-block" }}>▾</span>
            <div style={{ flex:1 }}>
              <div style={{ fontSize:13, fontWeight:800, color:pColor }}>{pName}</div>
              <div style={{ fontSize:9, color:"#555", marginTop:2 }}>{pSongs.length} tracks{pRange ? " · "+pRange : ""}</div>
            </div>
            <span style={{ fontSize:9, color: collapsedGenres["phase_"+pName]?pColor:"#555", fontWeight:600, padding:"2px 7px", borderRadius:3, background: collapsedGenres["phase_"+pName]?pColor+"22":"transparent", border:"1px solid "+(collapsedGenres["phase_"+pName]?pColor+"44":"transparent") }}>
              {collapsedGenres["phase_"+pName] ? "show" : "hide"}
            </span>
          </div>
        );
      }
      if (collapsedGenres["phase_"+pName]) { globalIdx++; return; }
    }

    // Skip phase headers in Mix Set mode — genre headers replace them
    // Smart Flow phase headers only
    if (!isMixSet && !isPhaseMode && vibeObj?.id === "smart") {
      const phaseId = assignPhase(song);
      const phase = PHASE_DEFS.find(p => p.id === phaseId) || PHASE_DEFS[4];
      if (phaseId !== currentPhaseId) {
        currentPhaseId = phaseId;
        rows.push(
          <div key={"ph-" + phaseId + "-" + i} style={{ display:"flex", alignItems:"center", gap:8, padding:"5px 10px", borderRadius:5, background:"rgba(255,255,255,0.02)", borderLeft:"4px solid " + phase.color, marginTop: i > 0 ? 8 : 0, marginBottom:3 }}>
            <div style={{ fontSize:11, fontWeight:700, color:phase.color }}>{phase.name}</div>
            <div style={{ fontSize:9, color:"#444" }}>{phase.bRange[0]}–{phase.bRange[1]} BPM</div>
          </div>
        );
      }
    }

    // Skip song rows when genre is collapsed
    if (isMixSet && isCollapsed) return;

    const phaseId = assignPhase(song);
    const phase = PHASE_DEFS.find(p => p.id === phaseId) || PHASE_DEFS[4];
    const isDragging = dragging === i;
    const isDropTarget = dropTarget === i && dragging !== null && dragging !== i;

    rows.push(
      <div
        key={song.id}
        draggable
        onDragStart={() => handleDragStart(i)}
        onDragEnter={() => handleDragEnter(i)}
        onDragEnd={handleDragEnd}
        onDragOver={e => e.preventDefault()}
        style={{ opacity: isDragging ? 0.4 : 1, outline: isDropTarget ? "2px solid #22d3ee" : "none", borderRadius:5, transition:"opacity .15s" }}
      >
        <SongRow
          song={song} idx={i} total={setlist.length}
          expanded={expandedId === song.id}
          onToggle={onToggle}
          prev={i > 0 ? setlist[i-1] : null}
          phaseColor={isMixSet ? (genreColorMap[(primaryGenre(song)).toLowerCase()] || "#888") : isPhaseMode ? (PHASE_DEFS.find(p=>p.name===song._phaseName)?.color || "#888") : phase.color}
          onRemove={onRemove}
          onMove={moveToPosition}
          vibeObj={vibeObj}
          onPlay={onPlay}
          isPlaying={playingId === song.id}
          elapsedFull={elapsedFullArr ? elapsedFullArr[i] : null}
          elapsedCue={elapsedCueArr ? elapsedCueArr[i] : null}
          dragHandleProps={{}}
          mixsetTransition={mixsetTransitions ? mixsetTransitions[song.id] : null}
          prevMixsetTransition={mixsetTransitions && i > 0 ? mixsetTransitions[setlist[i-1].id] : null}
        />
      </div>
    );
  });

  return <div style={{ userSelect:"none" }}>{rows}</div>;
}

// ─── PHASE SECTION (kept for reference / live mode mini list) ─────────────────
function PhaseSection({ phase, songs, expandedId, onToggle, onRemove, vibeObj, globalOffset, onPlay, playingId, elapsedFullArr, elapsedCueArr }) {
  const [collapsed, setCollapsed] = useState(false);
  if (!songs.length) return null;
  const avgBpm = Math.round(songs.reduce((s, x) => s + (x.b || 0), 0) / songs.length);
  return (
    <div style={{ marginBottom:12 }}>
      <div onClick={() => setCollapsed(x => !x)} style={{ display:"flex", alignItems:"center", gap:8, padding:"8px 10px", borderRadius:6, background:"rgba(255,255,255,0.03)", borderLeft:"4px solid " + phase.color, cursor:"pointer", marginBottom: collapsed ? 0 : 4 }}>
        <span style={{ color:phase.color, transform: collapsed ? "rotate(-90deg)" : "rotate(0)", transition:"transform .2s", fontSize:12 }}>▾</span>
        <div style={{ flex:1 }}>
          <div style={{ fontSize:12, fontWeight:700, color:"#e0e0e0" }}>{phase.name}</div>
          <div style={{ fontSize:10, color:"#555" }}>{phase.bRange[0]}–{phase.bRange[1]} BPM</div>
        </div>
        <div style={{ display:"flex", gap:8, fontSize:10, color:"#666", fontFamily:"monospace" }}>
          <span>{songs.length} tracks</span>
          <span>{avgBpm} avg BPM</span>
        </div>
      </div>
      {!collapsed && songs.map((song, si) => (
        <SongRow key={song.id} song={song} idx={globalOffset + si} total={songs.length} expanded={expandedId === song.id} onToggle={onToggle} prev={si > 0 ? songs[si - 1] : null} phaseColor={phase.color} onRemove={onRemove} onMove={() => {}} vibeObj={vibeObj} onPlay={onPlay} isPlaying={playingId === song.id} elapsedFull={elapsedFullArr ? elapsedFullArr[globalOffset + si] : null} elapsedCue={elapsedCueArr ? elapsedCueArr[globalOffset + si] : null} dragHandleProps={{}} />
      ))}
    </div>
  );
}

