                </div>
              </div>

              {/* Smart Flow Shape Picker */}
              {activeVibe === "smart" && (
                <div style={{ marginBottom:12, padding:"12px", borderRadius:8, background:"rgba(34,211,238,0.03)", border:"1px solid rgba(34,211,238,0.12)" }}>
                  <div style={{ fontSize:10, fontWeight:700, color:"#22d3ee", textTransform:"uppercase", letterSpacing:1, marginBottom:8 }}>② Energy Shape</div>
                  <div style={{ display:"grid", gridTemplateColumns:"1fr 1fr", gap:5 }}>
                    {Object.entries(ENERGY_SHAPES).map(([key, shape]) => {
                      const isSelected = smartShape === key && !customPoints;
                      return (
                        <div key={key} onClick={() => { setSmartShape(key); setCustomPoints(null); }} style={{ padding:"8px 10px", borderRadius:6, cursor:"pointer", background: isSelected?"rgba(34,211,238,0.08)":"rgba(255,255,255,0.02)", border:"2px solid "+(isSelected?"#22d3ee":"rgba(255,255,255,0.05)"), transition:"all .15s" }}>
