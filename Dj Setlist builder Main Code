                  <div style={{ fontSize:11, fontWeight:700, color:"#facc15", textTransform:"uppercase", letterSpacing:.8 }}>⭐ Must Play ({mustPlay.length})</div>
                  <button onClick={() => setMustPlay([])} style={{ background:"none", border:"none", color:"#555", cursor:"pointer", fontSize:9 }}>Clear all</button>
