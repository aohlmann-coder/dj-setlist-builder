CURRENT SETLIST (${setlist.length} tracks):
${setlistSummary}

AVAILABLE LIBRARY TRACKS NOT YET IN SETLIST:
${candidateSummary}

CONTEXT FROM DJ: ${aiContext || "No additional context provided."}

Based on the current setlist flow, BPM progression, energy arc, and harmonic compatibility, please:

1. ANALYZE the current setlist — comment on the energy flow, any rough transitions, and overall narrative.
2. SUGGEST what to play next after the CURRENT track (pick from the library candidates if possible, or give general guidance).
3. FLAG any weak spots in the remaining setlist and suggest fixes.
4. Give 2-3 QUICK TIPS specific to this set.

Be concise and practical. Format your response as JSON with this exact structure:
{
  "analysis": "2-3 sentence overview of the set's current flow",
  "nextTrack": {
    "name": "song name or null",
    "artist": "artist or null",
    "reason": "why this works as the next track"
  },
  "weakSpots": [
    { "position": "e.g. tracks 4→5", "issue": "what's wrong", "fix": "how to fix it" }
  ],
  "tips": ["tip 1", "tip 2", "tip 3"]
}`;

    try {
      const resp = await fetch("https://api.anthropic.com/v1/messages", {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({
          model: "claude-sonnet-4-20250514",
          max_tokens: 1000,
          messages: [{ role: "user", content: prompt }]
        })
      });
      const data = await resp.json();
      const text = data.content?.map(c => c.text || "").join("") || "";
      const clean = text.replace(/```json|```/g, "").trim();
      const parsed = JSON.parse(clean);
      setAiSuggestions(parsed);
    } catch (e) {
      setAiError("AI suggestion failed: " + e.message);
    } finally {
      setAiLoading(false);
    }
  }, [setlist, library, nowPlaying, aiContext]);

  // Export — one playlist per genre/phase or single playlist
  const exportToSpotify = useCallback(async () => {
    if (!spotToken) { alert("Connect Spotify first."); return; }
    const spotifyTracks = setlist.filter(s => s.uri && s.uri.startsWith("spotify:"));
    if (!spotifyTracks.length) { alert("No Spotify tracks in setlist to export."); return; }
    setExporting(true); setExportMsg(null);
    try {
      if (activeVibe === "mixset" || activeVibe === "mixset2") {
        const genreGroups = [];
        let curG = null;
        for (const song of spotifyTracks) {
          const g = song._mixsetGenre || normalizeGenre(song.g || "") || (GENRE_CATEGORIES.includes((song.g||"").split(",")[0].trim()) ? (song.g||"").split(",")[0].trim() : "Other");
          if (g !== curG) { curG = g; genreGroups.push({ genre: g, tracks: [] }); }
          genreGroups[genreGroups.length-1].tracks.push(song);
        }
        const activeGenres = selectedExportGenres;
        const filtered = activeGenres ? genreGroups.filter(({genre}) => activeGenres.has(genre)) : genreGroups;
        if (!filtered.length) { alert("No genres selected for export."); setExporting(false); return; }
        const created = [];
        for (const { genre, tracks } of filtered) {
          const pl = await createSpotifyPlaylist(`${playlistName} - ${genre}`, tracks.map(s => s.uri), spotToken);
          created.push({ name: pl.name, url: pl.external_urls?.spotify || "#", count: tracks.length });
          await new Promise(r => setTimeout(r, 300));
        }
        setExportMsg({ ok: true, playlists: created });
      } else if (activeVibe === "phasemode") {
        const phaseGroups = [];
        let curPh = null;
        for (const song of spotifyTracks) {
          const ph = song._phaseName || "Other";
          if (ph !== curPh) { curPh = ph; phaseGroups.push({ phase: ph, tracks: [] }); }
          phaseGroups[phaseGroups.length-1].tracks.push(song);
        }
        const activePhases = selectedExportPhases;
        const filtered = activePhases ? phaseGroups.filter(({phase}) => activePhases.has(phase)) : phaseGroups;
        if (!filtered.length) { alert("No phases selected for export."); setExporting(false); return; }
        const created = [];
        for (const { phase, tracks } of filtered) {
          const pl = await createSpotifyPlaylist(`${playlistName} - ${phase}`, tracks.map(s => s.uri), spotToken);
          created.push({ name: pl.name, url: pl.external_urls?.spotify || "#", count: tracks.length });
          await new Promise(r => setTimeout(r, 300));
        }
        setExportMsg({ ok: true, playlists: created });
      } else {
        const pl = await createSpotifyPlaylist(playlistName, spotifyTracks.map(s => s.uri), spotToken);
        setExportMsg({ ok: true, playlists: [{ name: pl.name, url: pl.external_urls?.spotify || "#", count: spotifyTracks.length }] });
      }
    } catch (e) { setExportMsg({ ok: false, msg: e.message }); }
    finally { setExporting(false); }
  }, [spotToken, setlist, playlistName, activeVibe, selectedExportGenres, selectedExportPhases]);

  // ── Rating helpers ──
  const rateSong = useCallback((song, rating, position, note) => {
    const prev = setlist[position - 1];
    const next  = setlist[position + 1];
    const key = ratingKey(song);
    setRatings(prev => {
      const updated = { ...prev };
      if (!updated[key]) updated[key] = [];
      updated[key] = [...updated[key], {
        rating,        // "hit" | "miss"
        note:    note || "",
        date:    new Date().toISOString(),
        position,
        bpm:     song.b,
        key:     getCamelot(song.key||0, song.mode||0),
        energy:  song.e,
        genre:   song.g,
        prevSong: prev?.n || null,
        nextSong: next?.n || null,
        vibe:    activeVibe,
      }];
      saveRatings(updated);
      return updated;
    });
  }, [setlist, activeVibe]);

  const getSongRating = useCallback((song) => {
    const key = ratingKey(song);
    const history = ratings[key] || [];
    if (!history.length) return null;
    const hits = history.filter(r => r.rating === "hit").length;
    const misses = history.filter(r => r.rating === "miss").length;
    return { hits, misses, total: history.length, lastNote: history[history.length-1]?.note };
  }, [ratings]);

  // ── Save current set to history ──
  const saveSetToHistory = useCallback(() => {
    if (!setlist.length) return;
    const entry = {
      id:      Date.now(),
      date:    new Date().toISOString(),
      venue:   venueName || "Unnamed Set",
      tracks:  setlist.length,
      vibe:    activeVibe,
      shape:   activeVibe === "smart" ? smartShape : null,
      avgBpm:  Math.round(setlist.reduce((s,x)=>s+(x.b||0),0)/setlist.length),
      setlist: setlist.map(s => ({ id:s.id, n:s.n, a:s.a, b:s.b, e:s.e, g:s.g })),
    };
    setSetHistory(prev => {
      const updated = [entry, ...prev].slice(0, 50); // keep last 50 sets
      saveSetHistory(updated);
      return updated;
    });
    alert("Set saved to history!");
  }, [setlist, venueName, activeVibe, smartShape]);

  // ── Crowd preset helpers ──
  const saveCurrentAsPreset = useCallback(() => {
    if (!presetName.trim()) return;
    const preset = {
      id:         Date.now(),
      name:       presetName.trim(),
      vibe:       activeVibe,
      shape:      smartShape,
      genreZones: genreZones,
      setlistCount,
      setStartTime,
    };
    setCrowdPresets(prev => {
      const updated = [...prev, preset];
      saveCrowdPresets(updated);
      return updated;
    });
    setPresetName("");
    alert("Preset saved!");
  }, [presetName, activeVibe, smartShape, genreZones, setlistCount, setStartTime]);

  const loadPreset = useCallback((preset) => {
    if (preset.vibe) setActiveVibe(preset.vibe);
    if (preset.shape) setSmartShape(preset.shape);
    if (preset.genreZones) { setGenreZones(preset.genreZones); saveGenreZones(preset.genreZones); }
    if (preset.setlistCount) setSetlistCount(preset.setlistCount);
    if (preset.setStartTime) setSetStartTime(preset.setStartTime);
    setShowPresets(false);
  }, []);

  // Stats
  const totalMs = setlist.reduce((s, x) => s + x.du, 0);
  const avgBpm = setlist.length ? Math.round(setlist.reduce((s, x) => s + (x.b || 0), 0) / setlist.length) : 0;
  const spotCount = setlist.filter(s => s.source === "spotify").length;
  const tidalCount = setlist.filter(s => s.source === "tidal").length;
  // DJ mix time: cue-in to cue-out for each track
  const mixTimeMs = setlist.reduce((s, x, i) => {
    const cues = calcCuePoints(x, setlist[i + 1] || null);
    return s + (cues.cueOut - cues.cueIn);
  }, 0);
  const avgTrackPlayMs = setlist.length ? Math.round(mixTimeMs / setlist.length) : 0;

  // Cumulative elapsed times for each track position
  const elapsedFullArr = useMemo(() => {
    let acc = 0;
    return setlist.map(s => { const v = acc; acc += s.du || 0; return v; });
  }, [setlist]);
  const elapsedCueArr = useMemo(() => {
    let acc = 0;
    return setlist.map((s, i) => { const cues = calcCuePoints(s, setlist[i + 1] || null); const v = acc; acc += (cues.cueOut - cues.cueIn); return v; });
  }, [setlist]);

  return (
    <div style={{ background:"#0d0d0d", minHeight:"100vh", color:"#e0e0e0", fontFamily:"'Segoe UI',system-ui,sans-serif" }}>
      <div style={{ maxWidth:720, margin:"0 auto", padding:"14px 14px 60px" }}>

        {/* HEADER */}
        <div style={{ marginBottom:14, paddingBottom:12, borderBottom:"1px solid rgba(255,255,255,0.06)" }}>
          <div style={{ display:"flex", alignItems:"center", justifyContent:"space-between", flexWrap:"wrap", gap:8 }}>
            <div>
              <h1 style={{ fontSize:19, fontWeight:800, margin:0, letterSpacing:-.5, color:"#f0f0f0" }}>DJ Setlist Builder</h1>
              <div style={{ fontSize:10, color:"#444", marginTop:2 }}>Mixed crowd · {library.length} tracks in library</div>
            </div>
            <div style={{ display:"flex", gap:6 }}>
