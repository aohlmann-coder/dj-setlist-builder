                <button onClick={() => { saveAnthropicKey(keyInput); setAnthropicKey(keyInput); alert("API key saved!"); }} style={{ padding:"8px 14px", borderRadius:5, border:"none", background:"#22d3ee", color:"#000", fontSize:11, fontWeight:700, cursor:"pointer" }}>Save</button>
              </div>
              {anthropicKey ? <div style={{ fontSize:9, color:"#4ade80", marginTop:6 }}>✓ API key saved</div> : <div style={{ fontSize:9, color:"#f87171", marginTop:6 }}>⚠ No API key — tracks will not be enriched on import</div>}
            </div>

            {/* Genre Timeline */}
            <div style={{ marginBottom:14, padding:"14px", borderRadius:8, background:"rgba(255,255,255,0.02)", border:"1px solid rgba(255,255,255,0.06)" }}>
              <div style={{ fontSize:12, fontWeight:700, color:"#D4A574", marginBottom:4 }}>🎭 Genre Timeline</div>
              <div style={{ fontSize:9, color:"#555", marginBottom:10 }}>Drag genres between zones to control where they appear in your set. The algorithm rewards songs in their assigned zone.</div>
              <div style={{ display:"flex", flexDirection:"column", gap:8 }}>
                {TIMELINE_ZONES.map(zone => (
                  <div key={zone.id} onDragOver={e=>{e.preventDefault();}} onDrop={e=>{
                    e.preventDefault();
                    if (!dragGenre) return;
                    const { genre, fromZone } = dragGenre;
                    if (fromZone === zone.id) return;
                    setGenreZones(prev => {
                      const updated = { ...prev };
                      updated[fromZone] = (updated[fromZone]||[]).filter(g=>g!==genre);
                      updated[zone.id] = [...(updated[zone.id]||[]), genre];
                      saveGenreZones(updated);
                      return updated;
                    });
                    setDragGenre(null);
                  }} style={{ padding:"8px 10px", borderRadius:6, background:"rgba(255,255,255,0.02)", border:"2px solid "+zone.color+"33", minHeight:52 }}>
                    <div style={{ fontSize:10, fontWeight:700, color:zone.color, marginBottom:6 }}>{zone.emoji} {zone.label} <span style={{ fontSize:8, color:"#444", fontWeight:400 }}>— {zone.desc}</span></div>
                    <div style={{ display:"flex", flexWrap:"wrap", gap:4 }}>
                      {(genreZones[zone.id]||[]).map(genre => (
                        <div key={genre} draggable onDragStart={()=>setDragGenre({genre, fromZone:zone.id})} style={{ padding:"3px 8px", borderRadius:10, background:zone.color+"22", border:"1px solid "+zone.color+"44", color:zone.color, fontSize:9, cursor:"grab", userSelect:"none", display:"flex", alignItems:"center", gap:4 }}>
                          {genre}
                          <span onClick={()=>{ setGenreZones(prev=>{ const u={...prev}; u[zone.id]=(u[zone.id]||[]).filter(g=>g!==genre); saveGenreZones(u); return u; }); }} style={{ cursor:"pointer", color:"#666", fontSize:10, lineHeight:1 }}>×</span>
                        </div>
                      ))}
                      {/* Add genre input */}
                      <input placeholder="+ add genre" onKeyDown={e=>{
                        if (e.key==="Enter" && e.target.value.trim()) {
                          const g = e.target.value.trim();
                          setGenreZones(prev=>{ const u={...prev}; u[zone.id]=[...(u[zone.id]||[]),g]; saveGenreZones(u); return u; });
                          e.target.value="";
                        }
                      }} style={{ padding:"2px 6px", borderRadius:10, border:"1px dashed rgba(255,255,255,0.1)", background:"transparent", color:"#555", fontSize:9, outline:"none", width:80 }} />
                    </div>
                  </div>
                ))}
              </div>
              <button onClick={()=>{ setGenreZones(DEFAULT_GENRE_ZONES); saveGenreZones(DEFAULT_GENRE_ZONES); }} style={{ marginTop:8, padding:"5px 12px", borderRadius:4, border:"1px solid rgba(255,255,255,0.1)", background:"transparent", color:"#555", cursor:"pointer", fontSize:9 }}>Reset to defaults</button>
            </div>

            {/* Time of Day */}
            <div style={{ marginBottom:14, padding:"14px", borderRadius:8, background:"rgba(255,255,255,0.02)", border:"1px solid rgba(255,255,255,0.06)" }}>
              <div style={{ fontSize:12, fontWeight:700, color:"#f97316", marginBottom:4 }}>🕐 Set Start Time</div>
              <div style={{ fontSize:9, color:"#555", marginBottom:8 }}>Adjusts the energy curve target based on time of day. Evening sets push higher, morning sets start lower.</div>
              <input type="time" value={setStartTime} onChange={e=>setSetStartTime(e.target.value)} style={{ padding:"7px 10px", borderRadius:5, border:"1px solid rgba(255,255,255,0.1)", background:"rgba(255,255,255,0.03)", color:"#f97316", fontSize:12, outline:"none", fontFamily:"monospace" }} />
              {setStartTime && (
                <div style={{ marginTop:6, fontSize:10, color:"#888" }}>
                  Energy offset: {(() => { const h = parseInt(setStartTime.split(":")[0]); const off = timeOfDayEnergyOffset(h); return (off > 0 ? "+" : "") + off + "% ("; })()}
                  {(() => { const h = parseInt(setStartTime.split(":")[0]); if (h<12) return "morning — starting chill)"; if (h<17) return "afternoon — slightly relaxed)"; if (h<20) return "early evening — neutral)"; if (h<23) return "night — pushing higher)"; return "late night — peak energy)"; })()}
                </div>
              )}
            </div>

            {/* Cache management */}
            <div style={{ padding:"14px", borderRadius:8, background:"rgba(255,255,255,0.02)", border:"1px solid rgba(255,255,255,0.06)" }}>
              <div style={{ fontSize:12, fontWeight:700, color:"#888", marginBottom:8 }}>🗄 Data & Cache</div>
              <div style={{ fontSize:10, color:"#555", marginBottom:6 }}>
                {(() => { const c = loadLibCache(); return Object.keys(c).length; })()} tracks cached · {Object.keys(ratings).length} rated
              </div>
              <div style={{ marginBottom:10, padding:"10px", borderRadius:6, background:"rgba(251,191,36,0.05)", border:"1px solid rgba(251,191,36,0.15)" }}>
                <div style={{ fontSize:10, color:"#fbbf24", fontWeight:700, marginBottom:4 }}>⚡ AI Energy Scoring</div>
                <div style={{ fontSize:10, color:"#666", marginBottom:8 }}>Spotify energy scores are often inaccurate. Re-score your entire library using Claude AI based on how songs actually feel in a DJ set.</div>
                <button onClick={rescoreEnergyWithClaude} disabled={!library.length} style={{ padding:"6px 14px", borderRadius:5, border:"1px solid rgba(251,191,36,0.4)", background:"rgba(251,191,36,0.1)", color:"#fbbf24", cursor: library.length?"pointer":"not-allowed", fontSize:11, fontWeight:700, opacity: library.length?1:0.5 }}>
                  ⚡ Re-score Energy for all {library.length} tracks with AI
                </button>
              </div>
              <div style={{ display:"flex", gap:6, flexWrap:"wrap" }}>
                <button onClick={()=>{ if(confirm("Clear track data cache? Songs will be re-enriched on next import.")) localStorage.removeItem(LIB_CACHE_KEY); }} style={{ padding:"5px 10px", borderRadius:4, border:"1px solid rgba(239,68,68,0.3)", background:"rgba(239,68,68,0.08)", color:"#f87171", cursor:"pointer", fontSize:10 }}>Clear Track Cache</button>
                <button onClick={()=>{ if(confirm("Clear all " + library.length + " tracks from library?")) { setLibrary([]); setSetlist([]); setSetlistCount(20); } }} style={{ padding:"5px 10px", borderRadius:4, border:"1px solid rgba(239,68,68,0.3)", background:"rgba(239,68,68,0.08)", color:"#f87171", cursor:"pointer", fontSize:10 }}>Clear Library</button>
                <button onClick={()=>{ if(confirm("Clear all ratings?")) { saveRatings({}); setRatings({}); } }} style={{ padding:"5px 10px", borderRadius:4, border:"1px solid rgba(239,68,68,0.3)", background:"rgba(239,68,68,0.08)", color:"#f87171", cursor:"pointer", fontSize:10 }}>Clear Ratings</button>
                <button onClick={()=>{ if(confirm("Clear set history?")) { saveSetHistory([]); setSetHistory([]); } }} style={{ padding:"5px 10px", borderRadius:4, border:"1px solid rgba(239,68,68,0.3)", background:"rgba(239,68,68,0.08)", color:"#f87171", cursor:"pointer", fontSize:10 }}>Clear History</button>
              </div>
            </div>

            {/* Duplicate Detection */}
            {duplicates.length > 0 && (
              <div style={{ marginTop:14, padding:"14px", borderRadius:8, background:"rgba(250,204,21,0.04)", border:"1px solid rgba(250,204,21,0.2)" }}>
                <div style={{ fontSize:12, fontWeight:700, color:"#facc15", marginBottom:4 }}>⚠ Duplicate Tracks ({duplicates.length} groups)</div>
                <div style={{ fontSize:9, color:"#555", marginBottom:8 }}>Multiple versions of the same song detected in your library.</div>
                <div style={{ maxHeight:200, overflowY:"auto" }}>
                  {duplicates.map((group, gi) => (
                    <div key={gi} style={{ padding:"8px", borderRadius:5, marginBottom:6, background:"rgba(255,255,255,0.02)", border:"1px solid rgba(250,204,21,0.1)" }}>
                      {group.map((song, si) => (
                        <div key={si} style={{ display:"flex", alignItems:"center", gap:8, padding:"3px 0", borderBottom: si < group.length-1 ? "1px solid rgba(255,255,255,0.03)" : "none" }}>
                          {song.img && <img src={song.img} alt="" style={{ width:20, height:20, borderRadius:2 }} />}
                          <div style={{ flex:1 }}>
                            <div style={{ fontSize:10, color:"#ccc" }}>{song.n}</div>
                            <div style={{ fontSize:9, color:"#555" }}>{song.a} · {song.b||"?"}bpm · E:{song.e||"?"}%</div>
                          </div>
                          <span style={{ fontSize:9, color: si===0 ? "#4ade80" : "#555" }}>{si===0 ? "★ Best" : "dupe"}</span>
                        </div>
                      ))}
                    </div>
                  ))}
                </div>
              </div>
            )}
          </div>
        )}
        {showImport && (
          <div style={{ position:"fixed", inset:0, background:"rgba(0,0,0,0.85)", zIndex:999, display:"flex", alignItems:"center", justifyContent:"center", padding:16 }}>
            <div style={{ background:"#141414", borderRadius:10, padding:20, width:"100%", maxWidth:460, border:"1px solid rgba(255,255,255,0.08)", maxHeight:"80vh", overflowY:"auto" }}>
              <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", marginBottom:14 }}>
                <div style={{ fontSize:14, fontWeight:700, color:"#e0e0e0" }}>Import a Playlist</div>
                <button onClick={() => setShowImport(false)} style={{ background:"none", border:"none", color:"#666", cursor:"pointer", fontSize:18 }}>×</button>
              </div>
              {loadingLib && <div style={{ color:"#888", fontSize:12, textAlign:"center", padding:20 }}>Loading tracks...</div>}
              {!loadingLib && (
                <>
                  {spotToken && (
                    <div style={{ marginBottom:12 }}>
                      <div style={{ fontSize:11, fontWeight:700, color:"#1DB954", marginBottom:6, textTransform:"uppercase", letterSpacing:.8 }}>Spotify Playlists</div>
                      {spotPlaylists.length === 0 && <div style={{ fontSize:11, color:"#555" }}>No playlists found.</div>}
                      {spotPlaylists.map(pl => (
                        <div key={pl.id} style={{ display:"flex", alignItems:"center", gap:8, padding:"8px 10px", borderRadius:5, marginBottom:3, background:"rgba(29,185,84,0.05)", border:"1px solid rgba(29,185,84,0.1)", cursor:"pointer" }} onClick={() => importPlaylist({ ...pl, source:"spotify" })}>
                          {pl.images?.[0]?.url && <img src={pl.images[0].url} alt="" style={{ width:32, height:32, borderRadius:3 }} />}
                          <div style={{ flex:1 }}>
                            <div style={{ fontSize:12, color:"#e0e0e0" }}>{pl.name}</div>
                            <div style={{ fontSize:10, color:"#555" }}>{pl.tracks?.total || "?"} tracks</div>
                          </div>
                          {importingPl === pl.id ? <span style={{ fontSize:10, color:"#1DB954" }}>Loading...</span> : <span style={{ fontSize:11, color:"#1DB95488" }}>Import →</span>}
                        </div>
                      ))}
                    </div>
                  )}
                  {!spotToken && <div style={{ fontSize:12, color:"#555", textAlign:"center", padding:20 }}>Connect Spotify first.</div>}

                  {/* ── Exportify note ── */}
                  <div style={{ marginTop:14, paddingTop:14, borderTop:"1px solid rgba(255,255,255,0.06)", fontSize:10, color:"#555" }}>
                    💡 Use the <span style={{ color:"#f97316", fontWeight:700 }}>📥 Exportify</span> button in the tab bar to import Exportify CSV/XLSX data — BPM, key &amp; energy saved permanently to cache.
                  </div>
                </>
              )}
            </div>
          </div>
        )}

      </div>

      {/* ── MINI PLAYER BAR ── */}
      {playerReady && (
        <div style={{ position:"fixed", bottom:0, left:0, right:0, background:"linear-gradient(180deg, #1a1a1a, #0d0d0d)", borderTop:"1px solid rgba(255,255,255,0.08)", padding:"8px 14px", display:"flex", alignItems:"center", gap:10, zIndex:900 }}>
          {playingTrack ? (
            <>
              {playingTrack.img && <img src={playingTrack.img} alt="" style={{ width:36, height:36, borderRadius:4, objectFit:"cover" }} />}
              <div style={{ flex:1, minWidth:0 }}>
                <div style={{ fontSize:12, fontWeight:600, color:"#e0e0e0", whiteSpace:"nowrap", overflow:"hidden", textOverflow:"ellipsis" }}>{playingTrack.name}</div>
                <div style={{ fontSize:10, color:"#888" }}>{playingTrack.artist}</div>
              </div>
              <div style={{ display:"flex", gap:8, alignItems:"center" }}>
                <button onClick={skipPrev} style={{ background:"none", border:"none", color:"#aaa", cursor:"pointer", fontSize:16 }}>⏮</button>
                <button onClick={togglePlayPause} style={{ background:"#1DB954", border:"none", borderRadius:"50%", width:32, height:32, display:"flex", alignItems:"center", justifyContent:"center", cursor:"pointer", fontSize:14, color:"#000" }}>
                  {playingTrack.paused ? "▶" : "⏸"}
                </button>
                <button onClick={skipNext} style={{ background:"none", border:"none", color:"#aaa", cursor:"pointer", fontSize:16 }}>⏭</button>
              </div>
            </>
          ) : (
            <div style={{ flex:1, textAlign:"center", fontSize:11, color:"#555" }}>
              🎵 DJ Setlist Player ready — click ▶ on any song to play
            </div>
          )}
        </div>
      )}
    </div>
  );
}

ReactDOM.createRoot(document.getElementById("root")).render(<App />);
  </script>
</body>
</html>
