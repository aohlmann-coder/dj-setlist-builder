                  {missing.length === 0 && claudeOnly.length === 0 && (
                    <div style={{ fontSize:10, color:"#4ade80" }}>✓ All tracks have Exportify data</div>
                  )}
                </div>
              );
            })()}

            <input value={search} onChange={e => setSearch(e.target.value)} placeholder="Search library..." style={{ width:"100%", padding:"8px 12px", borderRadius:5, border:"1px solid rgba(255,255,255,0.08)", background:"rgba(255,255,255,0.03)", color:"#e0e0e0", fontSize:12, outline:"none", boxSizing:"border-box", marginBottom:8 }} />
            <div>
              {(search.trim() ? searchResults : library.slice(0, libVisible)).map(song => {
