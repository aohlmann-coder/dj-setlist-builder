                          </svg>
                          <div style={{ fontSize:8, color:"#555", marginTop:2 }}>{shape.desc}</div>
                        </div>
                      );
                    })}
                  </div>
                  {/* Customize control points */}
                  <div style={{ marginTop:10, padding:"8px", borderRadius:6, background:"rgba(255,255,255,0.02)", border:"1px solid rgba(255,255,255,0.04)" }}>
                    <div style={{ fontSize:9, fontWeight:700, color:"#555", textTransform:"uppercase", letterSpacing:.8, marginBottom:6 }}>Customize Energy Points</div>
                    <div style={{ display:"flex", gap:4, flexWrap:"wrap" }}>
                      {(customPoints || ENERGY_SHAPES[smartShape]?.points || []).map(([pos, energy], idx) => (
                        <div key={idx} style={{ display:"flex", alignItems:"center", gap:2, padding:"3px 6px", borderRadius:4, background:"rgba(255,255,255,0.03)", border:"1px solid rgba(255,255,255,0.06)" }}>
                          <span style={{ fontSize:9, color:"#555", minWidth:24 }}>{pos}%:</span>
                          <input type="number" min="0" max="100" value={energy} onChange={e => {
                            const pts = [...(customPoints || ENERGY_SHAPES[smartShape]?.points || [])].map(p=>[...p]);
                            pts[idx][1] = Math.max(0, Math.min(100, parseInt(e.target.value)||0));
                            setCustomPoints(pts);
                          }} style={{ width:36, padding:"2px 4px", borderRadius:3, border:"1px solid rgba(34,211,238,0.2)", background:"transparent", color:"#22d3ee", fontSize:10, textAlign:"center", outline:"none", fontFamily:"monospace" }} />
                        </div>
                      ))}
                    </div>
                    {customPoints && <button onClick={() => setCustomPoints(null)} style={{ marginTop:6, padding:"3px 10px", borderRadius:4, border:"1px solid rgba(255,255,255,0.1)", background:"transparent", color:"#666", cursor:"pointer", fontSize:9 }}>Reset to preset</button>}
                  </div>
                </div>
              )}
            </div>

            {/* Count + Build */}
            <div style={{ display:"flex", gap:6, alignItems:"center", marginBottom:14, flexWrap:"wrap" }}>
              <div style={{ fontSize:11, fontWeight:700, color:"#666", textTransform:"uppercase", letterSpacing:1 }}>{activeVibe === "smart" ? "③" : "②"} Tracks:</div>
              {[10,20,40,60,100,150,200].map(n => (
                <button key={n} onClick={() => setSetlistCount(n)} style={{ padding:"5px 10px", borderRadius:5, border:"2px solid "+(setlistCount===n?"#a78bfa":"rgba(255,255,255,0.07)"), background: setlistCount===n?"rgba(167,139,250,0.12)":"transparent", color: setlistCount===n?"#a78bfa":"#666", cursor:"pointer", fontSize:11, fontWeight:600 }}>{n}</button>
              ))}
              <input type="number" min="1" max="500" value={setlistCount} onChange={e => { const v = parseInt(e.target.value); if (v > 0) setSetlistCount(v); }} style={{ width:52, padding:"5px 6px", borderRadius:5, border:"2px solid rgba(255,255,255,0.07)", background:"transparent", color:"#a78bfa", fontSize:11, fontWeight:600, textAlign:"center", outline:"none", fontFamily:"monospace" }} />
              <button onClick={buildSetlist} disabled={!activeVibe} style={{ marginLeft:"auto", padding:"8px 18px", borderRadius:7, border:"none", cursor: activeVibe?"pointer":"not-allowed", background: activeVibe?"linear-gradient(135deg,"+(vibeObj?.color||"#888")+","+(vibeObj?.color||"#888")+"66)":"rgba(255,255,255,0.04)", color: activeVibe?"#fff":"#333", fontSize:12, fontWeight:700, opacity: activeVibe?1:.5 }}>
                {setlist.length ? "Rebuild" : "Build Setlist"}
              </button>
            </div>

            {/* Setlist */}
            {setlist.length > 0 && (
              <div>
                {/* Stats */}
                <div style={{ display:"flex", marginBottom:4, borderRadius:7, overflow:"hidden", border:"1px solid rgba(255,255,255,0.05)" }}>
                  {[["Tracks", setlist.length, "#a78bfa"],["Avg BPM", avgBpm, "#f97316"],["Full Time", fmtTimeHours(totalMs), "#4ade80"]].map(([l,val,c],i)=>(
                    <div key={l} style={{ flex:1, padding:"9px 6px", background:"rgba(255,255,255,0.02)", borderRight:i<2?"1px solid rgba(255,255,255,0.05)":"none", textAlign:"center" }}>
                      <div style={{ fontSize:14, fontWeight:800, color:c, fontFamily:"monospace" }}>{val}</div>
                      <div style={{ fontSize:9, color:"#444", marginTop:1, textTransform:"uppercase", letterSpacing:.6 }}>{l}</div>
                    </div>
                  ))}
                  <div style={{ flex:1, padding:"9px 6px", background:"rgba(255,255,255,0.02)", textAlign:"center" }}>
                    <div style={{ fontSize:11, fontWeight:700, lineHeight:1.4 }}>
                      {spotCount > 0 && <span style={{ color:"#1DB954" }}>{spotCount}🟢 </span>}
                      {tidalCount > 0 && <span style={{ color:"#00FFFF" }}>{tidalCount}🔵 </span>}
                      {setlist.length - spotCount - tidalCount > 0 && <span style={{ color:"#888" }}>{setlist.length - spotCount - tidalCount}⚪</span>}
                    </div>
                    <div style={{ fontSize:9, color:"#444", marginTop:1, textTransform:"uppercase", letterSpacing:.6 }}>Sources</div>
                  </div>
                </div>
                {/* DJ Mix Stats */}
                <div style={{ display:"flex", marginBottom:10, borderRadius:7, overflow:"hidden", border:"1px solid rgba(255,255,255,0.05)" }}>
                  {[["DJ Mix Time", fmtTimeHours(mixTimeMs), "#38bdf8"],["Avg Play/Track", fmtTime(avgTrackPlayMs), "#D4A574"],["Cue Coverage", Math.round(mixTimeMs / (totalMs || 1) * 100) + "%", "#c084fc"]].map(([l,val,c],i)=>(
                    <div key={l} style={{ flex:1, padding:"7px 6px", background:"rgba(255,255,255,0.015)", borderRight:i<2?"1px solid rgba(255,255,255,0.04)":"none", textAlign:"center" }}>
                      <div style={{ fontSize:12, fontWeight:700, color:c, fontFamily:"monospace" }}>{val}</div>
                      <div style={{ fontSize:8, color:"#444", marginTop:1, textTransform:"uppercase", letterSpacing:.5 }}>{l}</div>
                    </div>
                  ))}
                </div>

                {/* Search add */}
                <div style={{ position:"relative", marginBottom:10 }}>
                  <input value={search} onChange={e => setSearch(e.target.value)} placeholder="Search to add tracks..." style={{ width:"100%", padding:"8px 12px", borderRadius:6, border:"1px solid rgba(255,255,255,0.08)", background:"rgba(255,255,255,0.03)", color:"#e0e0e0", fontSize:12, outline:"none", boxSizing:"border-box" }} />
                  {searchResults.length > 0 && (
                    <div style={{ position:"absolute", top:"100%", left:0, right:0, zIndex:200, background:"#1a1a1a", borderRadius:"0 0 6px 6px", border:"1px solid rgba(255,255,255,0.08)", borderTop:"none", maxHeight:220, overflowY:"auto" }}>
                      {searchResults.map(s => {
                        const vs = vibeObj ? vibeScore(s, vibeObj) : 50;
                        const fc = vs >= 70 ? "#4ade80" : vs >= 50 ? "#facc15" : "#f87171";
                        return (
                          <div key={s.id} onClick={() => addFromSearch(s)} style={{ padding:"8px 12px", cursor:"pointer", borderBottom:"1px solid rgba(255,255,255,0.04)", display:"flex", alignItems:"center", gap:8 }} onMouseEnter={e=>e.currentTarget.style.background="rgba(255,255,255,0.05)"} onMouseLeave={e=>e.currentTarget.style.background="transparent"}>
                            {s.img && <img src={s.img} alt="" style={{ width:24, height:24, borderRadius:2, objectFit:"cover" }} />}
                            <div style={{ flex:1 }}><div style={{ fontSize:12, color:"#e0e0e0" }}>{s.n}</div><div style={{ fontSize:10, color:"#666" }}>{s.a} · {s.b || "—"} BPM</div></div>
                            <span style={{ fontSize:10, color:fc, fontFamily:"monospace" }}>{vs}% fit</span>
                          </div>
                        );
                      })}
                    </div>
                  )}
                </div>

                {/* Drag-to-reorder flat setlist with phase headers */}
                <DraggableSetlist
                  setlist={setlist}
                  setSetlist={setSetlist}
                  expandedId={expandedId}
                  onToggle={id => setExpandedId(p => p===id?null:id)}
                  onRemove={id => setSetlist(p=>p.filter(s=>s.id!==id))}
                  vibeObj={vibeObj}
                  onPlay={playerReady ? (song) => { playingTrack && !playingTrack.paused && playingTrack.id === song.id ? togglePlayPause() : playSong(song); } : null}
                  playingId={playingTrack && !playingTrack.paused ? playingTrack.id : null}
                  elapsedFullArr={elapsedFullArr}
                  elapsedCueArr={elapsedCueArr}
                  mixsetTransitions={mixsetTransitions}
                  isMixSet={activeVibe === "mixset" || activeVibe === "mixset2"}
                  isPhaseMode={activeVibe === "phasemode"}
                />

                {/* ── BPM + Energy Arcs ── */}
                {(() => {
                  const bpms = setlist.map(s => s.b || 0);
                  const energies = setlist.map(s => s.e || 50);
                  const bMax = Math.max(...bpms), bMin = Math.min(...bpms);
                  const W = 500, H = 48, n = setlist.length;
                  const bpmPoints = bpms.map((b, i) => {
                    const x = n <= 1 ? W/2 : (i / (n-1)) * W;
                    const y = bMax === bMin ? H/2 : H - 4 - ((b - bMin) / (bMax - bMin)) * (H - 8);
                    return x + "," + y;
                  }).join(" ");
                  const energyPoints = energies.map((e, i) => {
                    const x = n <= 1 ? W/2 : (i / (n-1)) * W;
                    const y = H - 4 - (e / 100) * (H - 8);
                    return x + "," + y;
                  }).join(" ");
                  const avgEnergy = Math.round(energies.reduce((s,x)=>s+x,0)/energies.length);
                  return (
                    <div style={{ marginTop:8 }}>
                      <div style={{ padding:"10px 12px", borderRadius:7, background:"rgba(255,255,255,0.02)", border:"1px solid rgba(255,255,255,0.04)", marginBottom:6 }}>
                        <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", marginBottom:4 }}>
                          <span style={{ fontSize:10, fontWeight:700, color:"#444", textTransform:"uppercase", letterSpacing:.8 }}>BPM Arc</span>
                          <span style={{ fontSize:9, color:"#555", fontFamily:"monospace" }}>{bMin}–{bMax} BPM</span>
                        </div>
                        <svg width="100%" viewBox={"0 0 "+W+" "+H} preserveAspectRatio="none" style={{ display:"block", height:48, overflow:"visible" }}>
                          <polyline fill="none" stroke="#1DB954" strokeWidth="2" strokeOpacity="0.7" points={bpmPoints} />
                          {bpms.map((b, i) => {
                            const x = n<=1?W/2:(i/(n-1))*W;
                            const y = bMax===bMin?H/2:H-4-((b-bMin)/(bMax-bMin))*(H-8);
                            return <circle key={i} cx={x} cy={y} r="2.5" fill="#1DB954" fillOpacity="0.8"><title>{setlist[i]?.n+" ("+b+" BPM)"}</title></circle>;
                          })}
                        </svg>
                        <div style={{ display:"flex", justifyContent:"space-between", marginTop:2 }}>
                          <span style={{ fontSize:9, color:"#555", fontFamily:"monospace" }}>{setlist[0]?.b} BPM</span>
                          <span style={{ fontSize:9, color:"#555", fontFamily:"monospace" }}>{setlist[setlist.length-1]?.b} BPM</span>
                        </div>
                      </div>
                      <div style={{ padding:"10px 12px", borderRadius:7, background:"rgba(255,255,255,0.02)", border:"1px solid rgba(255,255,255,0.04)" }}>
                        <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", marginBottom:4 }}>
                          <span style={{ fontSize:10, fontWeight:700, color:"#444", textTransform:"uppercase", letterSpacing:.8 }}>Energy Arc</span>
                          <span style={{ fontSize:9, color:"#555", fontFamily:"monospace" }}>avg {avgEnergy}%</span>
                        </div>
                        <svg width="100%" viewBox={"0 0 "+W+" "+H} preserveAspectRatio="none" style={{ display:"block", height:48, overflow:"visible" }}>
                          {/* Target shape overlay if smart mode */}
                          {activeVibe === "smart" && (() => {
                            const shapePoints = customPoints || (ENERGY_SHAPES[smartShape]?.points || []);
                            const shapePts = shapePoints.map(([px, py]) => ((px/100)*W)+","+(H-4-(py/100)*(H-8))).join(" ");
                            return <polyline fill="none" stroke="#22d3ee" strokeWidth="1" strokeOpacity="0.25" strokeDasharray="4,3" points={shapePts} />;
                          })()}
                          <polyline fill="none" stroke="#ef4444" strokeWidth="2" strokeOpacity="0.7" points={energyPoints} />
                          {energies.map((e, i) => {
                            const x = n<=1?W/2:(i/(n-1))*W;
                            const y = H-4-(e/100)*(H-8);
                            const c = e>=75?"#ef4444":e>=55?"#facc15":e>=35?"#4ade80":"#6B8E8D";
                            return <circle key={i} cx={x} cy={y} r="2.5" fill={c} fillOpacity="0.9"><title>{setlist[i]?.n+" (Energy: "+e+"%)"}</title></circle>;
                          })}
                        </svg>
                        <div style={{ display:"flex", justifyContent:"space-between", marginTop:2 }}>
                          <span style={{ fontSize:9, color:"#555" }}>Low</span>
                          <span style={{ fontSize:9, color:"#555" }}>High</span>
                        </div>
                      </div>
                    </div>
                  );
                })()}

                {/* ── Set Weak Spots Report ── */}
                {(() => {
                  const issues = [];
                  for (let i = 1; i < setlist.length; i++) {
                    const prev = setlist[i-1], curr = setlist[i];
                    const bpmDiff = Math.abs((prev.b||0) - (curr.b||0));
                    const energyDiff = Math.abs((prev.e||50) - (curr.e||50));
                    const prevCam = getCamelot(prev.key||0, prev.mode||0);
                    const currCam = getCamelot(curr.key||0, curr.mode||0);
                    
                    if (bpmDiff > 6) issues.push({ idx:i, type:"bpm", severity:"high", msg:`BPM jump: ${prev.b}→${curr.b} (+${bpmDiff})`, from:prev.n, to:curr.n, color:"#ef4444" });
                    else if (bpmDiff > 3) issues.push({ idx:i, type:"bpm", severity:"med", msg:`BPM shift: ${prev.b}→${curr.b} (+${bpmDiff})`, from:prev.n, to:curr.n, color:"#facc15" });
                    const keyDist = camelotDistance(prevCam, currCam);
                    if (keyDist !== null && keyDist > 1 && prevCam !== "?" && currCam !== "?") {
                      issues.push({ idx:i, type:"key", severity:"high", msg:`Key clash: ${prevCam}→${currCam} (${keyDist} steps)`, from:prev.n, to:curr.n, color:"#ef4444" });
                    }
                    
                    if (energyDiff > 35) issues.push({ idx:i, type:"energy", severity:"high", msg:`Energy drop/spike: ${prev.e}%→${curr.e}%`, from:prev.n, to:curr.n, color:"#38bdf8" });
                  }
                  
                  if (!issues.length) return (
                    <div style={{ marginTop:6, padding:"8px 12px", borderRadius:7, background:"rgba(74,222,128,0.05)", border:"1px solid rgba(74,222,128,0.15)", fontSize:11, color:"#4ade80" }}>
                      ✓ No weak spots detected — smooth set!
                    </div>
                  );
                  
                  return (
                    <div style={{ marginTop:6, padding:"10px 12px", borderRadius:7, background:"rgba(255,255,255,0.02)", border:"1px solid rgba(255,255,255,0.04)" }}>
                      <div style={{ fontSize:10, fontWeight:700, color:"#f87171", textTransform:"uppercase", letterSpacing:.8, marginBottom:6 }}>⚠ Weak Spots ({issues.length})</div>
                      <div style={{ maxHeight:150, overflowY:"auto" }}>
                        {issues.map((iss, i) => (
                          <div key={i} style={{ display:"flex", alignItems:"center", gap:6, padding:"4px 0", borderBottom:"1px solid rgba(255,255,255,0.03)", fontSize:10 }}>
                            <span style={{ color:iss.color, fontWeight:700, fontFamily:"monospace", minWidth:18 }}>#{iss.idx}</span>
                            <span style={{ color:iss.color, fontWeight:600 }}>{iss.msg}</span>
                            <span style={{ color:"#555", flex:1, textAlign:"right", overflow:"hidden", whiteSpace:"nowrap", textOverflow:"ellipsis" }}>{iss.from} → {iss.to}</span>
                          </div>
                        ))}
                      </div>
                    </div>
                  );
                })()}

                {/* ── Harmonic Mixing Analysis ── */}
                {(() => {
                  let harmonicCount = 0, clashCount = 0;
                  const bridges = [];
                  for (let i = 1; i < setlist.length; i++) {
                    const prevCam = getCamelot(setlist[i-1].key||0, setlist[i-1].mode||0);
                    const currCam = getCamelot(setlist[i].key||0, setlist[i].mode||0);
