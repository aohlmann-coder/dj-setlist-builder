              {exportifyStatus.error ? "⚠ " + exportifyStatus.error : exportifyStatus.done > 0 ? `✓ ${exportifyStatus.done} tracks loaded & genre-classified` : exportifyStatus.msg ? "⏳ " + exportifyStatus.msg : "⏳ Parsing..."}
            </div>
          )}
        </div>

        {libError && <div style={{ padding:"8px 12px", borderRadius:5, background:"rgba(239,68,68,0.1)", border:"1px solid rgba(239,68,68,0.3)", color:"#f87171", fontSize:11, marginBottom:12 }}>{libError}</div>}

        {bpmProgress && (
          <div style={{ padding:"10px 14px", borderRadius:7, background:"rgba(34,211,238,0.06)", border:"1px solid rgba(34,211,238,0.2)", marginBottom:12 }}>
            <div style={{ display:"flex", justifyContent:"space-between", alignItems:"center", marginBottom:6 }}>
              <span style={{ fontSize:11, color:"#22d3ee", fontWeight:700 }}>🧠 {bpmProgress.label || "Enriching tracks..."}</span>
              <span style={{ fontSize:11, color:"#888", fontFamily:"monospace" }}>{bpmProgress.done} / {bpmProgress.total}</span>
            </div>
            <div style={{ height:4, borderRadius:2, background:"rgba(255,255,255,0.06)", overflow:"hidden" }}>
              <div style={{ height:"100%", borderRadius:2, background:"linear-gradient(90deg,#22d3ee,#4ade80)", transition:"width 0.3s", width: (bpmProgress.total ? (bpmProgress.done / bpmProgress.total * 100) : 0) + "%" }} />
            </div>
            {bpmProgress.cacheHits > 0 && <div style={{ fontSize:9, color:"#555", marginTop:4 }}>⚡ {bpmProgress.cacheHits} tracks loaded from cache — only new songs hit the API</div>}
          </div>
        )}

        {/* LIBRARY TAB */}
        {tab === "library" && (
          <div>
            {/* Must Play Section */}
            {mustPlay.length > 0 && (
