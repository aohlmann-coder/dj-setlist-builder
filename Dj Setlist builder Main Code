      done += batch.length;
      setBpmProgress({ done, total: library.length, cacheHits: 0, label: "Re-scoring energy with AI..." });
      if (i + BATCH < library.length) await new Promise(r => setTimeout(r, 300));
    }
    setLibrary(prev => prev.map(t => updatedMap[t.id] !== undefined ? { ...t, e: updatedMap[t.id], _aiEnergy: true } : t));
    setBpmProgress(null);
    console.log("[DJ] Energy rescore complete:", Object.keys(updatedMap).length, "tracks updated");
  }, [library]);

  // Smart build
  const buildSetlist = useCallback(async () => {
    const vibe = VIBES.find(v => v.id === activeVibe);
    if (!vibe) return;
    setMixsetTransitions({});

    // Time-of-day energy offset
    const startHour = setStartTime ? parseInt(setStartTime.split(":")[0]) : -1;
    const todOffset = startHour >= 0 ? timeOfDayEnergyOffset(startHour) : 0;
    
    if (activeVibe === "mixed") {
      // ── MIXED ALL-DAY PARTY MODE ──
      // Priority: 1) Energy waves  2) Smooth BPM  3) Harmonic keys  4) Genre variety
      
      const pool = library.filter(s => s.b && s.b > 0);
      if (!pool.length) { setSetlist(library.slice(0, setlistCount)); return; }
      
      // Must-play songs: mark them so they're guaranteed inclusion
      const mustPlayIds = new Set(mustPlay.map(s => s.id));
      const mustPlayPool = pool.filter(s => mustPlayIds.has(s.id));
      
      // Step 1: Create an energy target curve (the "wave")
      // This generates a sine-wave-like pattern with multiple peaks and valleys
      const targets = [];
      const numWaves = Math.max(2, Math.floor(setlistCount / 25)); // ~1 wave per 25 tracks
      for (let i = 0; i < setlistCount; i++) {
        const pct = i / (setlistCount - 1 || 1); // 0 to 1
        // Start at 30%, build with multiple peaks, each wave slightly higher
        const baseRamp = 20 + pct * 30; // gradual upward trend 20→50
        const wave = Math.sin(pct * numWaves * Math.PI * 2 - Math.PI/2); // oscillates -1 to 1
        const waveAmplitude = 20 + pct * 15; // waves get bigger as set progresses
        const target = Math.max(10, Math.min(100, baseRamp + wave * waveAmplitude));
        targets.push(Math.round(target));
      }
      
      // Step 2: Greedy song selection — pick the best song for each slot
      const used = new Set();
      const result = [];
      
      for (let i = 0; i < setlistCount && used.size < pool.length; i++) {
        const targetEnergy = targets[i];
        const prev = result.length > 0 ? result[result.length - 1] : null;
        const prevCam = prev ? getCamelot(prev.key || 0, prev.mode || 0) : null;
        const prevGenres = prev && prev.g ? prev.g.toLowerCase().split(",").map(g => g.trim()) : [];
        const prev2 = result.length > 1 ? result[result.length - 2] : null;
        const prev2Genres = prev2 && prev2.g ? prev2.g.toLowerCase().split(",").map(g => g.trim()) : [];
        
        // Check if there are unused must-play songs that need to be placed
        const unusedMustPlay = mustPlayPool.filter(s => !used.has(s.id)).length;
        const slotsLeft = setlistCount - i;
        const mustPlayUrgent = unusedMustPlay > 0 && unusedMustPlay >= slotsLeft * 0.5;
        
        let bestSong = null;
        let bestScore = -Infinity;
        
        for (const song of pool) {
          if (used.has(song.id)) continue;
          let score = 0;
          
          // Priority 1: Energy match to target curve (0-40 points)
          const eDiff = Math.abs((song.e || 50) - targetEnergy);
          score += Math.max(0, 40 - eDiff * 1.2);
          
          // Priority 2: BPM — ±6 ceiling (0-25 points)
          if (prev) {
            score += bpmScore(prev.b || 100, song.b || 100, 25);
          } else {
            score += 12;
          }

          // Priority 3: Key — ±1 step only, 2+ = 0 (0-30 points)
          if (prev) {
            const prevCam2 = getCamelot(prev.key || 0, prev.mode || 0);
            const songCam = getCamelot(song.key || 0, song.mode || 0);
            score += keyScore(prevCam2, songCam, 30);
          } else {
            score += 15;
          }
          
          // Priority 4: Genre variety — penalize same genre in a row (0-10 points)
          const songGenres = song.g ? song.g.toLowerCase().split(",").map(g => g.trim()) : [];
          const genreOverlap = songGenres.filter(g => prevGenres.includes(g)).length;
          const genre2Overlap = songGenres.filter(g => prev2Genres.includes(g)).length;
          score += genreOverlap === 0 ? 10 : genreOverlap === 1 ? 5 : 0;
          score -= genre2Overlap * 2;
          
          // Must-play boost — big bonus so they get placed, even bigger when running out of slots
          if (mustPlayIds.has(song.id)) {
            score += mustPlayUrgent ? 60 : 25;
          }
          
