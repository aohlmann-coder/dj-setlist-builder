                <div onClick={() => setActiveVibe("bpmkey")} style={{ padding:"12px", borderRadius:8, cursor:"pointer", border:"2px solid "+(activeVibe==="bpmkey"?"#34d399":"rgba(255,255,255,0.07)"), background: activeVibe==="bpmkey"?"rgba(52,211,153,0.06)":"rgba(255,255,255,0.015)", boxShadow: activeVibe==="bpmkey"?"0 0 16px rgba(52,211,153,0.15)":"none", transition:"all .15s" }}>
                  <div style={{ fontSize:20, marginBottom:4 }}>BK</div>
