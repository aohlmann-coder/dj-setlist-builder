                  <div style={{ fontSize:10, color:"#555", marginTop:3 }}>BPM low→high → Camelot 1→12 (A/B interleaved)</div>
                </div>
                <div onClick={() => setActiveVibe("energymode")} style={{ padding:"12px", borderRadius:8, cursor:"pointer", border:"2px solid "+(activeVibe==="energymode"?"#fbbf24":"rgba(255,255,255,0.07)"), background: activeVibe==="energymode"?"rgba(251,191,36,0.06)":"rgba(255,255,255,0.015)", boxShadow: activeVibe==="energymode"?"0 0 16px rgba(251,191,36,0.15)":"none", transition:"all .15s" }}>
                  <div style={{ fontSize:20, marginBottom:4 }}>⚡</div>
                  <div style={{ fontSize:13, fontWeight:800, color: activeVibe==="energymode"?"#fbbf24":"#888" }}>Energy</div>
                  <div style={{ fontSize:10, color:"#555", marginTop:3 }}>Energy low→high → Camelot → BPM</div>
                </div>
                <div onClick={() => setActiveVibe("phasemode")} style={{ padding:"12px", borderRadius:8, cursor:"pointer", border:"2px solid "+(activeVibe==="phasemode"?"#e8a87c":"rgba(255,255,255,0.07)"), background: activeVibe==="phasemode"?"rgba(232,168,124,0.06)":"rgba(255,255,255,0.015)", boxShadow: activeVibe==="phasemode"?"0 0 16px rgba(232,168,124,0.15)":"none", transition:"all .15s" }}>
                  <div style={{ fontSize:20, marginBottom:4 }}>🌊</div>
                  <div style={{ fontSize:13, fontWeight:800, color: activeVibe==="phasemode"?"#e8a87c":"#888" }}>Phase Flow</div>
