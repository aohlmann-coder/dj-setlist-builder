};
const fmtTimeHours = ms => {
  const h = Math.floor(ms / 3600000);
  const m = Math.floor((ms % 3600000) / 60000);
  const s = Math.floor((ms % 60000) / 1000);
  if (h > 0) return h + "h " + m + "m " + String(s).padStart(2, "0") + "s";
  return m + "m " + String(s).padStart(2, "0") + "s";
};
const KEY_NAMES = ["C","C#","D","D#","E","F","F#","G","G#","A","A#","B"];
const CAMELOT = {"0-0":"5A","0-1":"8B","1-0":"12A","1-1":"3B","2-0":"7A","2-1":"10B","3-0":"2A","3-1":"5B","4-0":"9A","4-1":"12B","5-0":"4A","5-1":"7B","6-0":"11A","6-1":"2B","7-0":"6A","7-1":"9B","8-0":"1A","8-1":"4B","9-0":"8A","9-1":"11B","10-0":"3A","10-1":"6B","11-0":"10A","11-1":"1B"};
const getCamelot = (k, m) => CAMELOT[k + "-" + m] || "?";
const compatKeys = cam => {
  if (!cam || cam === "?") return [];
  const n = parseInt(cam), l = cam.slice(-1), opp = l === "A" ? "B" : "A";
  return [cam, (n % 12 + 1) + l, ((n - 2 + 12) % 12 + 1) + l, n + opp];
};
// Camelot wheel distance: 0=same, 1=adjacent/relative, higher=clash
const camelotDistance = (ca, cb) => {
  if (!ca || !cb || ca === "?" || cb === "?") return null;
  const na = parseInt(ca), la = ca.slice(-1);
  const nb = parseInt(cb), lb = cb.slice(-1);
  if (na === nb && la !== lb) return 1; // relative major/minor
  if (la === lb) { const d = Math.abs(na - nb); return Math.min(d, 12 - d); }
  const d = Math.abs(na - nb); return Math.min(d, 12 - d) + 1;
};
// Key score: 0 steps = full, 1 step = 60%, 2+ = 0 (hard block)
const keyScore = (ca, cb, maxPts) => {
  const dist = camelotDistance(ca, cb);
  if (dist === null) return Math.round(maxPts * 0.15);
  if (dist === 0) return maxPts;
  if (dist === 1) return Math.round(maxPts * 0.6);
  return 0; // 2+ steps = no points at all
};
// BPM score: ±6 is the useful ceiling; beyond that, 0
const bpmScore = (bA, bB, maxPts) => {
  const bd = Math.min(Math.abs(bA - bB), Math.abs(bA - bB * 2), Math.abs(bA * 2 - bB));
  return bd <= 2 ? maxPts : bd <= 4 ? Math.round(maxPts * 0.75) : bd <= 6 ? Math.round(maxPts * 0.4) : 0;
};
// Priority: BPM (40) → Key (35) → Energy (20)
const transScore = (a, b) => {
  if (!a || !b) return null;
  let sc = 0;
  sc += bpmScore(a.b, b.b, 40);
