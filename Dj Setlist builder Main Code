function assignPhase(song) {
  const b = song.b || 100, e = song.e || 50;
  for (const p of PHASE_DEFS) {
    if (b >= p.bRange[0] && b <= p.bRange[1] && e >= p.eRange[0] && e <= p.eRange[1]) return p.id;
  }
  return "p5";
}

// ─── CUE POINTS & TRANSITION SUGGESTIONS ─────────────────────────────────────
function calcCuePoints(song, nextSong) {
  const dur = song.du || 180000;

  // CUE IN: after intro, where the hook/groove kicks in
  // Shorter songs intro faster; longer songs have more room
  const cueInPct = dur < 150000 ? 0.08 : dur < 240000 ? 0.12 : 0.15;
  const cueIn = Math.round(dur * cueInPct);

  // HOT CUE: the peak moment — 2nd chorus / best part of the track
  const hotCue = Math.round(dur * 0.58);

  // CUE OUT: smart calculation based on next song context
  let cueOutPct = 0.82; // default

  if (nextSong) {
    const bpmDiff = Math.abs((song.b || 100) - (nextSong.b || 100));
    const energyDiff = (nextSong.e || 50) - (song.e || 50); // positive = energy rising
    const keyDist = camelotDistance(getCamelot(song.key||0, song.mode||0), getCamelot(nextSong.key||0, nextSong.mode||0));
    const keyCompat = keyDist !== null && keyDist <= 1;

    if (bpmDiff <= 3 && keyCompat) {
      // Perfect match — long blend, start transition early, ride it out
      cueOutPct = 0.90;
    } else if (bpmDiff <= 5 && keyCompat) {
      // Great match — still blend but a bit tighter
      cueOutPct = 0.87;
    } else if (bpmDiff <= 8) {
      // Decent match — standard transition window
      cueOutPct = 0.82;
    } else if (bpmDiff <= 14) {
      // Bigger BPM jump — need a quicker exit, cut earlier
      cueOutPct = 0.76;
    } else {
      // Hard cut territory — backspin/drop, exit late at a peak moment
      cueOutPct = 0.72;
    }

    // Energy rising into next song: ride current song longer (crowd is building)
    if (energyDiff > 20) cueOutPct = Math.min(0.92, cueOutPct + 0.04);
    // Energy dropping: exit earlier so the drop doesn't drag
    if (energyDiff < -20) cueOutPct = Math.max(0.68, cueOutPct - 0.05);
  }

  const cueOut = Math.round(dur * cueOutPct);

  // Clamp cue out so it's always after hot cue and before end
  const clampedCueOut = Math.max(hotCue + 15000, Math.min(dur - 8000, cueOut));

  return { cueIn, hotCue, cueOut: clampedCueOut, cueOutPct };
}

function suggestTransition(prev, next) {
  if (!prev || !next) return null;
  const bpmDiff = Math.abs((prev.b || 100) - (next.b || 100));
  const prevCam = getCamelot(prev.key || 0, prev.mode || 0);
  const nextCam = getCamelot(next.key || 0, next.mode || 0);
  const keyDist2 = camelotDistance(prevCam, nextCam);
  const keyCompat = keyDist2 !== null && keyDist2 <= 1;
  const energyDiff = Math.abs((prev.e || 50) - (next.e || 50));
  
  if (bpmDiff <= 2 && keyCompat) {
    return { 
      type: "EQ SWAP", color: "#4ade80",
      tip: "Perfect match! Blend using EQ swap — cut bass on outgoing, bring in bass on incoming over 8-16 bars.",
      djayPro: "Use the EQ knobs: pull low EQ to 0 on Deck A while pushing low EQ to full on Deck B. Crossfade slowly."
    };
  }
  if (bpmDiff <= 4 && keyCompat) {
    return {
      type: "LONG BLEND", color: "#4ade80",
      tip: "Great harmonic match. Long blend over 16-32 bars — let the grooves lock together.",
      djayPro: "Sync tempos, use the crossfader for a gradual 16-bar blend. Use EQ to carve space for each track."
    };
  }
  if (bpmDiff <= 6) {
    return {
      type: "ECHO OUT", color: "#facc15",
      tip: "Strip outgoing to kicks via high-pass filter. Build 4-8 bars, slam next track in on the 1.",
      djayPro: "Apply Echo Out effect on Deck A (set to 1/2 beat). As echo tails, cut to Deck B on the downbeat."
    };
  }
  if (bpmDiff <= 12) {
    return {
      type: "FILTER SWEEP", color: "#38bdf8",
      tip: "High-pass outgoing, low-pass incoming, cross in the middle. Masks key and tempo shifts.",
      djayPro: "Use the filter knob — sweep Deck A to high-pass while sweeping Deck B from low-pass to full. Meet in the middle."
    };
  }
  if (bpmDiff > 12 || energyDiff > 30) {
    return {
      type: "BACKSPIN / DROP", color: "#a78bfa",
      tip: "Big tempo/energy shift — quick backspin on outgoing, drop next track on the 1. Commit to it!",
      djayPro: "Use the backspin effect or manually spin the platter back. Cut crossfader hard to Deck B right on beat 1."
    };
  }
  return {
    type: "ECHO OUT", color: "#facc15",
    tip: "Standard transition. Use echo/reverb tail on outgoing track, bring in next on the downbeat.",
    djayPro: "Apply Echo Out on Deck A, let it fade, then bring Deck B in clean on beat 1."
  };
}

// ─── SMART "WHAT'S NEXT" SUGGESTIONS ──────────────────────────────────────────
function getNextSuggestions(currentSong, library, setlist, count) {
  if (!currentSong) return [];
  const inSet = new Set(setlist.map(s => s.id));
  const currentCam = getCamelot(currentSong.key || 0, currentSong.mode || 0);
  return library
    .filter(s => !inSet.has(s.id) && s.b && s.b > 0)
    .map(s => {
      let score = 0;
      score += bpmScore(currentSong.b || 0, s.b || 0, 40);
      score += keyScore(currentCam, getCamelot(s.key || 0, s.mode || 0), 35);
      const eDiff = Math.abs((currentSong.e || 50) - (s.e || 50));
      score += eDiff <= 10 ? 20 : eDiff <= 20 ? 15 : eDiff <= 30 ? 5 : 0;
      return { ...s, _matchScore: Math.min(100, score) };
    })
    .sort((a, b) => b._matchScore - a._matchScore)
    .slice(0, count || 5);
}

// ─── CHEAT SHEET GENERATOR ───────────────────────────────────────────────────
function generateCheatSheet(setlist) {
  let text = "DJ SETLIST CHEAT SHEET\n";
  text += "=" .repeat(60) + "\n";
  text += "Tracks: " + setlist.length + " | Generated: " + new Date().toLocaleString() + "\n\n";
  
  let currentPhase = "";
  setlist.forEach((song, i) => {
    const phase = PHASE_DEFS.find(p => assignPhase(song) === p.id);
    if (phase && phase.name !== currentPhase) {
      currentPhase = phase.name;
      text += "\n--- " + phase.name + " ---\n";
    }
    const next = i < setlist.length - 1 ? setlist[i + 1] : null;
    const cues = calcCuePoints(song, next);
    const cam = getCamelot(song.key || 0, song.mode || 0);
    const prev = i > 0 ? setlist[i - 1] : null;
    const trans = suggestTransition(prev, song);
    
    text += "\n#" + (i + 1) + " " + song.n + " — " + song.a + "\n";
    text += "   BPM: " + (song.b || "?") + " | Key: " + fmtKey(song.key, song.mode, cam) + " | Energy: " + (song.e || "?") + "%\n";
    text += "   CUE IN: " + fmtTime(cues.cueIn) + " | HOT CUE: " + fmtTime(cues.hotCue) + " | CUE OUT: " + fmtTime(cues.cueOut) + "\n";
    if (trans) {
      text += "   TRANSITION: " + trans.type + " — " + trans.tip + "\n";
      text += "   DJAY PRO: " + trans.djayPro + "\n";
    }
  });
  
  text += "\n\n" + "=" .repeat(60) + "\n";
  text += "MIXING REFERENCE\n";
  text += "EQ SWAP — Cut bass outgoing, bring in bass incoming. 8-16 bars.\n";
  text += "LONG BLEND — Gradual crossfade 16-32 bars. Use EQ to carve space.\n";
  text += "ECHO OUT — High-pass outgoing, echo tail, slam next track on 1.\n";
  text += "FILTER SWEEP — HPF outgoing, LPF incoming, cross in middle.\n";
  text += "BACKSPIN — Quick backspin, drop next on the 1.\n";
  text += "HOT CUE SPEED — Jump to red cue, play 30-60s, transition out.\n";
  
  return text;
}

