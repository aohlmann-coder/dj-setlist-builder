      const songList = batch.map((t, idx) => `${idx+1}. "${t.n}" by ${t.a}${t.g?" ["+t.g+"]":""}${t.era?" ("+t.era+")":""}`).join("\n");
      const prompt = `You are an expert DJ. For each song score ENERGY 0-100 for a DJ set context.
0-20: slow ballads, ambient. 21-40: chill grooves, slow jams. 41-60: mid-tempo, classic soul.
61-80: uptempo dance, hype hip hop. 81-100: peak hour bangers, intense drops.
Return ONLY a JSON array, no markdown. Each object: { "i": song_number, "energy": 0-100 }
Songs:\n${songList}`;
      try {
