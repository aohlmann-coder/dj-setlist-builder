async function spotifyGet(path, token) {
  const r = await fetch("https://api.spotify.com/v1" + path, {
    headers: { Authorization: "Bearer " + token },
  });
  if (!r.ok) throw new Error("Spotify API error " + r.status);
  return r.json();
}
async function fetchSpotifyPlaylists(token) {
  const data = await spotifyGet("/me/playlists?limit=50", token);
  return data.items || [];
}
async function fetchSpotifyTracks(playlistId, token) {
  // Feb 2026: Spotify renamed /tracks to /items
  let url = `/playlists/${playlistId}/items?limit=100`;
  let all = [];
  let attempt = 0;
  while (url) {
    attempt++;
    console.log("[DJ] Fetching:", "https://api.spotify.com/v1" + url);
    const r = await fetch("https://api.spotify.com/v1" + url, {
      headers: { Authorization: "Bearer " + token },
    });
    console.log("[DJ] Response status:", r.status);
    if (!r.ok) {
      const errText = await r.text();
      console.warn("[DJ] Error body:", errText);
      // Fallback: try old /tracks endpoint
      if (url.includes("/items") && attempt <= 1) {
        console.log("[DJ] Trying fallback /tracks endpoint...");
        url = url.replace("/items", "/tracks");
        continue;
      }
      throw new Error("Spotify API error " + r.status);
    }
    const data = await r.json();
    console.log("[DJ] Response data keys:", Object.keys(data));
    console.log("[DJ] Items count:", (data.items || []).length);
    if (data.items && data.items.length > 0) {
      console.log("[DJ] First item keys:", Object.keys(data.items[0]));
      console.log("[DJ] First item:", JSON.stringify(data.items[0]).substring(0, 500));
    }
    all = all.concat(data.items || []);
    url = data.next ? data.next.replace("https://api.spotify.com/v1", "") : null;
  }
  console.log("[DJ] Total raw items:", all.length);
  // Handle Feb 2026 change: "track" field renamed to "item"
  const processed = all.filter(i => {
    const t = i.item || i.track || i;
    return t && t.id;
  }).map(i => {
    const t = i.item || i.track || i;
    return {
      id: t.id, n: t.name || "Unknown", a: (t.artists || []).map(x => x.name).join(", ") || "Unknown",
      du: t.duration_ms || 0, uri: t.uri || "", img: t.album?.images?.[2]?.url || t.album?.images?.[0]?.url || "",
      b: 0, e: 50, d: 60, v: 60, key: 0, mode: 1, g: "", source: "spotify",
    };
  });
  console.log("[DJ] Processed tracks:", processed.length);
  return processed;
}
async function fetchAudioFeatures(ids, token) {
  const chunks = [];
  for (let i = 0; i < ids.length; i += 100) chunks.push(ids.slice(i, i + 100));
  const out = {};
  for (const chunk of chunks) {
    const data = await spotifyGet("/audio-features?ids=" + chunk.join(","), token);
    (data.audio_features || []).forEach(f => {
      if (f) out[f.id] = {
        b: Math.round(f.tempo), e: Math.round(f.energy * 100),
        d: Math.round(f.danceability * 100), v: Math.round(f.valence * 100),
        key: f.key >= 0 ? f.key : 0, mode: f.mode,
      };
    });
  }
  return out;
}

