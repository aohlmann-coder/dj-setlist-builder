// Rating key: "songTitle|||artist"
function ratingKey(song) {
  return (song.n + "|||" + song.a).toLowerCase().replace(/[^a-z0-9|]/g, "");
}

// Time-of-day energy curve adjustment
function timeOfDayEnergyOffset(startHour) {
  // startHour: 0-23. Returns a curve offset (-20 to +20)
  if (startHour >= 6  && startHour < 12) return -15; // morning: start lower
  if (startHour >= 12 && startHour < 17) return -8;  // afternoon: slightly lower
  if (startHour >= 17 && startHour < 20) return 0;   // early evening: neutral
  if (startHour >= 20 && startHour < 23) return 10;  // night: push higher
  if (startHour >= 23 || startHour < 2)  return 15;  // late night: peak
  return 0;
}

// Genre zone scoring bonus
function genreZoneBonus(song, position, setlistCount, genreZones) {
  const pct = position / (setlistCount - 1 || 1); // 0-1
  let zone;
  if (pct < 0.15) zone = "early";
  else if (pct < 0.35) zone = "midearly";
  else if (pct < 0.65) zone = "middle";
  else if (pct < 0.85) zone = "midlate";
  else zone = "late";

  const zoneGenres = (genreZones[zone] || []).map(g => g.toLowerCase());
  const songGenres = (song.g || "").toLowerCase().split(",").map(g => g.trim()).filter(Boolean);
  const match = songGenres.some(g => zoneGenres.some(z => g.includes(z) || z.includes(g)));
  return match ? 15 : 0;
}

// Era proximity bonus (songs from same/adjacent decade score higher together)
function eraProximityBonus(songA, songB) {
  if (!songA?.era || !songB?.era) return 0;
  const parseEra = e => parseInt(e) || 0;
  const diff = Math.abs(parseEra(songA.era) - parseEra(songB.era));
  return diff === 0 ? 8 : diff <= 10 ? 4 : 0;
}

// Duplicate detection
function findDuplicates(library) {
  const groups = {};
  for (const song of library) {
    // Normalize: strip "(Remaster)", "(Live)", year, etc.
    const base = song.n.toLowerCase()
      .replace(/\s*[\(\[][^)\]]*(?:remaster|live|remix|radio|edit|version|deluxe|acoustic|original)[^)\]]*[\)\]]/gi, "")
      .replace(/\s*-\s*\d{4}.*/g, "")
      .replace(/[^a-z0-9 ]/g, "").trim();
    const artistBase = song.a.split(",")[0].toLowerCase().replace(/[^a-z0-9 ]/g, "").trim();
    const key = base + "|||" + artistBase;
    if (!groups[key]) groups[key] = [];
    groups[key].push(song);
  }
  return Object.values(groups).filter(g => g.length > 1);
}

function generateRandomString(length) {
  const possible = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz0123456789";
  const values = crypto.getRandomValues(new Uint8Array(length));
  return values.reduce((acc, x) => acc + possible[x % possible.length], "");
}
async function sha256(plain) {
  const data = new TextEncoder().encode(plain);
  return window.crypto.subtle.digest("SHA-256", data);
}
function base64urlencode(arrayBuffer) {
  return btoa(String.fromCharCode(...new Uint8Array(arrayBuffer)))
    .replace(/\+/g, "-").replace(/\//g, "_").replace(/=+$/, "");
}
async function spotifyAuthRedirect() {
  const codeVerifier = generateRandomString(64);
  const hashed = await sha256(codeVerifier);
  const codeChallenge = base64urlencode(hashed);
  sessionStorage.setItem("spotify_code_verifier", codeVerifier);
  const params = new URLSearchParams({
    response_type: "code",
    client_id: SPOTIFY_CLIENT_ID,
    scope: SPOTIFY_SCOPES,
    redirect_uri: SPOTIFY_REDIRECT,
    code_challenge_method: "S256",
    code_challenge: codeChallenge,
    show_dialog: "true",
  });
  window.location.href = "https://accounts.spotify.com/authorize?" + params.toString();
}
async function exchangeSpotifyCode(code) {
  const codeVerifier = sessionStorage.getItem("spotify_code_verifier");
  if (!codeVerifier) throw new Error("Missing code verifier");
  const resp = await fetch("https://accounts.spotify.com/api/token", {
    method: "POST",
    headers: { "Content-Type": "application/x-www-form-urlencoded" },
    body: new URLSearchParams({
      client_id: SPOTIFY_CLIENT_ID,
      grant_type: "authorization_code",
      code,
      redirect_uri: SPOTIFY_REDIRECT,
      code_verifier: codeVerifier,
    }),
  });
  if (!resp.ok) throw new Error("Token exchange failed: " + resp.status);
  const data = await resp.json();
  sessionStorage.removeItem("spotify_code_verifier");
  return data.access_token;
}
function getSpotifyCodeFromUrl() {
  const params = new URLSearchParams(window.location.search);
  return params.get("code") || null;
}

function tidalAuthUrl() {
  const params = new URLSearchParams({
    response_type: "code",
    client_id: TIDAL_CLIENT_ID,
    redirect_uri: TIDAL_REDIRECT,
    scope: "playlists.read playlists.write",
  });
  return "https://login.tidal.com/oauth2/auth?" + params.toString();
}

