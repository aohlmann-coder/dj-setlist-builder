            if (idx < 0 || idx >= batch.length) continue;
            const t = batch[idx];
            const energy = Math.min(100, Math.max(0, Math.round(r.energy)));
            updatedMap[t.id] = energy;
            const ck = libCacheKey(t.n, t.a);
