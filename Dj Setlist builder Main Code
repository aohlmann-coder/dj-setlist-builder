  "B":  [11,1],"Bm": [11,0],
};
function parseKeyString(keyStr) {
  if (!keyStr) return [0, 1];
  const clean = keyStr.trim().replace(/\s+/g, "");
  if (KEY_MAP[clean]) return KEY_MAP[clean];
  for (const k of Object.keys(KEY_MAP)) {
    if (clean.toLowerCase().startsWith(k.toLowerCase())) return KEY_MAP[k];
  }
  return [0, 1];
}

