                return (
                  <div key={song.id} style={{ display:"flex", alignItems:"center", gap:8, padding:"7px 10px", borderRadius:4, marginBottom:2, background: isMust ? "rgba(250,204,21,0.03)" : "rgba(255,255,255,0.02)", borderLeft:"2px solid " + (isMust ? "#facc15" : song.source==="spotify"?"#1DB954":song.source==="tidal"?"#00FFFF":"#555") }}>
                    {song.img && <img src={song.img} alt="" style={{ width:28, height:28, borderRadius:3, objectFit:"cover" }} />}
                    <div style={{ flex:1, minWidth:0 }}>
                      <div style={{ fontSize:12, color:"#e0e0e0", whiteSpace:"nowrap", overflow:"hidden", textOverflow:"ellipsis" }}>{song.n}</div>
                      <div style={{ fontSize:10, color:"#666", display:"flex", alignItems:"center", gap:5 }}>
                        <span>{song.a} · {song.b || "—"} BPM · {fmtKey(song.key, song.mode, getCamelot(song.key||0, song.mode||0))}</span>
                        <span style={{ fontSize:8, padding:"1px 4px", borderRadius:2, fontWeight:700, background:badge.bg, border:"1px solid "+badge.border, color:badge.color }}>{badge.icon} {badge.label}</span>
                        {sr ? <span style={{ marginLeft:2 }}>{sr.hits>0?"🔥":""}{sr.misses>0?"👎":""}</span> : ""}
                      </div>
                    </div>
                    <button onClick={() => isMust ? removeMustPlay(song.id) : addMustPlay(song)} style={{ padding:"4px 8px", borderRadius:4, border:"1px solid " + (isMust ? "rgba(250,204,21,0.3)" : "rgba(255,255,255,0.08)"), background: isMust ? "rgba(250,204,21,0.1)" : "transparent", color: isMust ? "#facc15" : "#666", cursor:"pointer", fontSize:12, lineHeight:1 }} title={isMust ? "Remove from Must Play" : "Add to Must Play"}>
                      {isMust ? "⭐" : "☆"}
                    </button>
                    <button onClick={() => inSet ? setSetlist(p=>p.filter(x=>x.id!==song.id)) : addFromSearch(song)} style={{ padding:"4px 10px", borderRadius:4, border:"1px solid rgba(255,255,255,0.1)", background: inSet?"rgba(239,68,68,0.1)":"rgba(255,255,255,0.05)", color: inSet?"#f87171":"#aaa", cursor:"pointer", fontSize:10, fontWeight:600 }}>
